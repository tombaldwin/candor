#!/usr/bin/env bash
# candor — the umbrella dispatcher (candor-spec §3.3.1). ONE `candor` command across every language.
#
#   • a QUERY (where/path/show/…) is routed by the DISCOVERED report's backend — the filename tail
#     `.JS` → TypeScript, `.jvm` → Java, `.Swift` → Swift, and everything else (Rust's `.scan` syntactic
#     backend plus the nightly-lint crate-types `.lib`/`.Executable`/`.Rlib`/…) → Rust.
#   • a SCAN (`candor scan .`, or `candor <dir>`) is routed by the project's manifest — Cargo.toml → Rust,
#     package.json / tsconfig.json → TypeScript, build.gradle / pom.xml / *.java → Java, Package.swift → Swift.
#
# It execs the matching engine's QUALIFIED CLI (candor-query, candor-ts-query, candor-java, candor-swift) —
# they all speak the same §3.3.1 grammar, so every flag and verb passes straight through. This owns the bare
# `candor` name so four language packages don't fight over it, and it NEVER guesses silently: an ambiguous
# project (or a missing engine) is a loud, actionable error, not a wrong-engine run.
#
# Set CANDOR_DISPATCH_DRYRUN=1 to print the resolved command instead of running it (used by the tests).

CDBIN="${CANDOR_CACHE:-$HOME/.candor}/bin"   # where candor-rust/install.sh stashes candor-scan + candor-query
UMBRELLA_VERSION="0.15.0"                    # the umbrella's own version; tracks the family release line
QUERY_VERBS=" show where callers map containment diff reachable impact blindspots gains path tour whatif fix fix-gate unverified rewire parsepolicy agents "

die()  { echo "candor: $*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
# a Rust raw bin lives on PATH or under ~/.candor/bin
rust_bin() { if have "$1"; then echo "$1"; elif [ -x "$CDBIN/$1" ]; then echo "$CDBIN/$1"; else return 1; fi; }
# run (or, in dry-run, just announce) the resolved engine command
run() {
  if [ -n "${CANDOR_DISPATCH_DRYRUN:-}" ]; then echo "WOULD-RUN: $*"; exit 0; fi
  if [ -n "${CANDOR_DISPATCH_NOEXEC:-}" ]; then "$@"; return $?; fi
  exec "$@"
}

# candor-java resolution, in preference order: a `candor-java` launcher on PATH → the native binary the
# umbrella stashes (`candor update`, no JVM needed) → `java -jar <jar>` (CANDOR_JAVA_JAR or a stashed jar).
run_java() {
  if have candor-java; then run candor-java "$@"; fi
  [ -x "$CDBIN/candor-java" ] && run "$CDBIN/candor-java" "$@"
  local jar="${CANDOR_JAVA_JAR:-}"
  [ -n "$jar" ] || jar="$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)"
  [ -n "$jar" ] && [ -f "$jar" ] || die "a Java target, but no candor-java engine — run \`candor update\` to fetch it (or set CANDOR_JAVA_JAR)."
  run java -jar "$jar" "$@"
}

# ---- update notifications (OPT-IN, off by default; privacy: the network CHECK rides only the admin
# commands update/outdated/doctor, throttled to once/day and CACHED; the notice itself is a local cache
# read, so it never adds a network call to scan/query/gate). Enable: `candor config update-check on`. ----
SETTINGS="${CANDOR_CACHE:-$HOME/.candor}/settings"
UPDATE_CACHE="${CANDOR_CACHE:-$HOME/.candor}/update-check"
setting() { [ -f "$SETTINGS" ] && sed -n "s/^$1=//p" "$SETTINGS" | head -1; }
# refresh the cached "latest per channel" — the ONE network action here; callers gate it on opt-in+staleness
refresh_update_cache() {
  have curl || return 0
  local ljvm lrust lts now
  ljvm=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-java/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
  lrust=$(curl -fsSL -H "User-Agent: candor-cli" "https://crates.io/api/v1/crates/candor-scan" 2>/dev/null | sed -n 's/.*"max_stable_version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
  lts=$(curl -fsSL "https://registry.npmjs.org/candor-ts/latest" 2>/dev/null | sed -n 's/.*"version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
  now=$(date +%s 2>/dev/null || echo 0)
  mkdir -p "$(dirname "$UPDATE_CACHE")"
  { echo "checked=$now"; echo "jvm=$ljvm"; echo "rust=$lrust"; echo "ts=$lts"; } > "$UPDATE_CACHE" 2>/dev/null || true
}
# on an admin command, when opted in and the cache is >24h old, refresh it (network). Silent otherwise.
maybe_refresh_update_cache() {
  [ "$(setting update-check)" = on ] || return 0
  local checked=0 now
  [ -f "$UPDATE_CACHE" ] && checked=$(sed -n 's/^checked=//p' "$UPDATE_CACHE" | head -1)
  now=$(date +%s 2>/dev/null || echo 0)
  [ $((now - ${checked:-0})) -ge 86400 ] && refresh_update_cache
}
# the newest cached channel version greater than the umbrella pin (empty if none / no cache) — no network.
newest_beyond_pin() {
  [ -f "$UPDATE_CACHE" ] || return 0
  python3 - "$UPDATE_CACHE" "$UMBRELLA_VERSION" <<'PY' 2>/dev/null || true
import sys
cache, pin = sys.argv[1], sys.argv[2]
def t(v):
    try: return tuple(int(x) for x in (v.split(".")+["0","0","0"])[:3])
    except Exception: return (0,0,0)
latest = {}
for line in open(cache):
    if "=" in line and not line.startswith("checked"):
        k,v = line.strip().split("=",1)
        if v: latest[k]=v
newer = [v for v in latest.values() if t(v) > t(pin)]
if newer: print(sorted(newer, key=t)[-1])
PY
}
# describe a version beyond the pin as a spec-compatible point release or a new line
newer_kind() { case "$1" in "${UMBRELLA_VERSION%.*}".*) echo "a point release ($1, spec-compatible)";; *) echo "a new version ($1)";; esac; }
# print a one-line notice FROM CACHE (no network) if a newer version than the pin is known. Silent when
# opted out, no cache, or up to date. stderr, so it never corrupts --json on stdout.
show_update_notice() {
  [ "$(setting update-check)" = on ] || return 0
  [ -n "${CANDOR_DISPATCH_DRYRUN:-}" ] && return 0
  local newest; newest=$(newest_beyond_pin)
  [ -n "$newest" ] || return 0
  echo "candor: $(newer_kind "$newest") is available — \`candor outdated\` for detail, \`brew upgrade candor\` to update." >&2
}

# Sniff a token-less report FILE's backend from its §2.1 envelope (candor.toolchain / candor.version;
# meta.* for older rust shapes): jdk-* → jvm, swiftsyntax|candor-swift-* → Swift, node-*|candor-ts-* →
# JS, stable/nightly/scan-* → the open remainder (rust). Unreadable/absent envelope → JS (candor-ts is
# the only engine whose NATIVE primary shape is token-less, so it's the honest unreadable default).
sniff_backend() {
  python3 - "$1" 2>/dev/null <<'PYEOF' || echo JS
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    env = d.get("candor") or d.get("meta") or {}
    tc = str(env.get("toolchain", "")); v = str(env.get("version", ""))
except Exception:
    print("JS"); raise SystemExit
if tc.startswith("jdk"): print("jvm")
elif tc == "swiftsyntax" or v.startswith("candor-swift"): print("Swift")
elif tc.startswith("node") or v.startswith("candor-ts"): print("JS")
else: print("scan")
PYEOF
}

# ---- QUERY: route by the discovered report's backend ---------------------------------------------------
route_query() {
  local verb="$1"; shift
  # honor an explicit --report <loc>; else discover a `.candor/` ancestor from $PWD (the §3.3.1 rule)
  local a prev="" loc=""
  for a in "$@"; do [ "$prev" = "--report" ] && loc="$a"; prev="$a"; done
  # Resolve the locator to the report FILES by the ONE §3.3.1 rule (the same rule every engine applies):
  # a DIRECTORY → its `.candor/report` family; a `.json` path → that single report file; anything else →
  # a bare PREFIX (`<prefix>.<pkg>.<backend>.json`). No --report → discover a `.candor/` ancestor. The old
  # code always globbed `<dir>/report.*.json`, so a --report naming a non-`report`-basename prefix or a
  # direct .json file died with "no report" — a locator every engine accepts but the dispatcher refused.
  local files=() famprefix=""
  if [ -n "$loc" ]; then
    if [ -d "$loc" ]; then famprefix="$loc/.candor/report"; files=("$famprefix".*.json)
    elif [ "${loc%.json}" != "$loc" ] && [ -f "$loc" ]; then files=("$loc")
    else famprefix="$loc"; files=("$loc".*.json); fi
  else
    local d="$PWD" base=""
    while :; do [ -d "$d/.candor" ] && { base="$d/.candor/report"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
    [ -n "$base" ] || die "no report — run \`candor scan\` first, or pass --report <locator>. (no .candor/ from $PWD upward)"
    famprefix="$base"; files=("$base".*.json)
  fi

  # the distinct backends present (the token before .json), excluding EVERY non-report sidecar the
  # engines write beside the reports — not just the callgraph/hierarchy pair: candor-scan also writes
  # `report.calibrated.json` + `report.encountered-<crate>.json` ledgers and `--gate-json` verdicts,
  # which previously counted as phantom "engines" and made the dispatcher refuse its own scan output
  # ("multiple engines' reports … disambiguate"). Same discrimination rule as the engines' loaders.
  local f b uniq="" n=0
  for f in "${files[@]}"; do
    [ -e "$f" ] || continue
    case "$f" in
      *.callgraph.json|*.hierarchy.json|*.calibrated.json|*.gate.json|*.encountered-*.json) continue;;
    esac
    b="${f%.json}"
    case "$(basename "$b")" in
      *.*) b="${b##*.}";;
      # a token-less `<name>.json` carries no backend in its NAME (candor-ts's primary shape — but
      # ALSO any engine's `--json > baseline.json` style direct output, which the old JS assumption
      # misrouted; max-review find). Sniff the §2.1 envelope's `candor.toolchain` instead: jdk-* →
      # java, swiftsyntax → swift, node-* → ts; anything else (stable/nightly/unreadable) follows
      # the family rule's open remainder → rust falls out of the sniffer's default below.
      *)   b="$(sniff_backend "$f")";;
    esac
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  done
  # a family prefix may ALSO carry the token-less `<prefix>.json` (the candor-ts shape) — the
  # `<prefix>.*.json` glob can never match it (no inner dot segment), so probe it directly. This runs
  # UNCONDITIONALLY (not only when n==0): a ts report.json beside a tokened engine's reports must
  # trip the multiple-engines ambiguity check, never be silently shadowed (max-review find).
  if [ -n "$famprefix" ] && [ -f "$famprefix.json" ]; then
    b="$(sniff_backend "$famprefix.json")"
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  fi
  [ "$n" -ge 1 ] || die "no report at ${loc:-the discovered .candor/} — run \`candor scan\` first, or check the --report locator."
  [ "$n" -eq 1 ] || die "multiple engines' reports at ${loc:-the discovered .candor/} (${uniq# }) — disambiguate with --report <locator>."

  # TS/Java/Swift use FIXED backend tokens; Rust owns the open remainder — `scan` (syntactic backend) plus
  # the nightly-lint crate-types (`lib`, `Executable`, `Rlib`, `Dylib`, `bin`, …). So match the three fixed
  # tokens explicitly and route everything else to candor-query, exactly as the Rust engine's own
  # report-backend detection does (any non-JS/jvm/Swift, non-sidecar report is a Rust report).
  case "${uniq# }" in
    JS)    if have candor-ts-query; then run candor-ts-query "$verb" "$@"
           else run npx -y -p candor-ts candor-ts-query "$verb" "$@"; fi;;
    jvm)   run_java "$verb" "$@";;
    Swift) have candor-swift || die "a Swift report, but candor-swift isn't installed."; run candor-swift "$verb" "$@";;
    *)     local c; c=$(rust_bin candor-query) || die "a Rust report, but candor-query isn't installed — install candor-rust."; run "$c" "$verb" "$@";;
  esac
}

# ---- SCAN: route by the project manifest ---------------------------------------------------------------
route_scan() {
  local a target="."
  for a in "$@"; do case "$a" in -*) ;; *) target="$a"; break;; esac; done
  local dir; if [ -d "$target" ]; then dir="$target"; else dir="$(dirname "$target")"; fi

  # a Java project = any Gradle/Maven manifest, or a loose *.java (checked one at a time — a single
  # `ls a b c` fails whenever ANY pattern is unmatched, which would hide a real match).
  java_manifest() {
    local g
    for g in "$dir/build.gradle" "$dir/build.gradle.kts" "$dir/settings.gradle" "$dir/settings.gradle.kts" "$dir/pom.xml"; do
      [ -f "$g" ] && return 0
    done
    for g in "$dir"/*.java; do [ -e "$g" ] && return 0; done
    return 1
  }
  local langs="" n=0
  add() { case " $langs " in *" $1 "*) ;; *) langs="$langs $1"; n=$((n+1));; esac; }
  [ -f "$dir/Cargo.toml" ] && add rust
  { [ -f "$dir/package.json" ] || [ -f "$dir/tsconfig.json" ]; } && add ts
  java_manifest && add java
  [ -f "$dir/Package.swift" ] && add swift

  [ "$n" -ge 1 ] || die "can't tell what language $dir is (no Cargo.toml / package.json / build.gradle / Package.swift). Run the engine directly: candor-scan | candor-ts | candor-java | candor-swift."
  [ "$n" -eq 1 ] || die "$dir mixes languages (${langs# }) — scan a specific subdirectory, or run the engine directly."

  case "${langs# }" in
    rust)  local c; c=$(rust_bin candor-scan) || die "a Rust project, but candor-scan isn't installed — install candor-rust."; run "$c" "$@";;
    ts)    if have candor-ts; then run candor-ts "$@"
           else run npx -y candor-ts "$@"; fi;;
    java)  run_java "$@";;
    swift) have candor-swift || die "a Swift project, but candor-swift isn't installed."; run candor-swift "$@";;
  esac
}

verb="${1:-}"
# opt-in, cache-only (no network here) — a one-line "newer version available" nudge, silent by default.
show_update_notice
case "$QUERY_VERBS" in
  *" $verb "*) route_query "$@"; exit $?;;
esac
case "$verb" in
  config)
    # tiny global settings store (~/.candor/settings). Currently one key: update-check on|off (default off).
    shift || true; key="${1:-}"; val="${2:-}"
    case "$key" in
      ""|list) echo "update-check=$([ "$(setting update-check)" = on ] && echo on || echo off)   # opt-in daily check for newer engine versions (off by default; the check only runs on update/outdated/doctor and is cached)"; exit 0;;
      update-check)
        case "$val" in
          on|off) mkdir -p "$(dirname "$SETTINGS")"; touch "$SETTINGS"
            tmp=$(mktemp); grep -v "^update-check=" "$SETTINGS" 2>/dev/null > "$tmp" || true; echo "update-check=$val" >> "$tmp"; mv "$tmp" "$SETTINGS"
            [ "$val" = on ] && echo "update-check on — candor will check for newer versions at most once/day (only when you run update/outdated/doctor) and show a one-line notice. No code or reports are ever sent; it queries the public package registries only. Turn off: candor config update-check off"
            [ "$val" = off ] && echo "update-check off — no automatic version checks. (candor outdated still checks on demand.)"
            exit 0;;
          *) die "usage: candor config update-check on|off";;
        esac;;
      *) die "unknown config key '$key' (known: update-check). \`candor config\` to list.";;
    esac;;
  ""|-h|--help)
    cat <<'H'
candor — the effect analyzer. One command across every language.

Each invocation routes to the matching engine: a scan by the
project's manifest, a query by the discovered report's backend. Every engine speaks
the same grammar, so verbs and flags pass straight through — and an ambiguous
target is a loud error, never a silent guess.

USAGE
  candor engines                       list the engines, where each comes from, and its status
  candor outdated                      check the release channels for newer engine versions
  candor config update-check on        opt in to a once/day newer-version notice (off by default)
  candor update [engine...]            fetch / refresh engines (JVM native binary, no JVM needed)
  candor init [<dir>]                  stand up the gate: scan, propose a policy, set the baseline
  candor scan <dir>                    analyse a project (engine picked by its manifest)
  candor <action> [args] [options]     query the discovered report (.candor/, walk-up)
  candor doctor                        check every engine is installed and compatible

COMMON ACTIONS
  where <Effect>            the functions that perform an effect
  path <fn> <Effect>        the call path by which a function reaches an effect
  callers <fn>              who calls a function, direct and transitive
  tour [N]                  the N most surprising transitive reaches (default 10)
  blindspots                the Unknown sources worth resolving, ranked by reach
  gains <current> <base>    what a new version newly reaches (the supply-chain diff)
  fix <fn> <Effect>         the boundary hoist that would clear a violation

ALL ACTIONS
  show  where  callers  map  containment  diff  reachable  impact  blindspots
  gains  path  tour  whatif  fix  fix-gate  unverified  rewire  parsepolicy  agents

OPTIONS  (uniform across every engine)
  --report <locator>        use this report instead of discovering .candor/
  --policy <file>           evaluate a policy — exit 1 on a violation
  --json                    machine-readable output

EXAMPLES
  candor scan .
  candor where Db
  candor path OrderService.render Net
  candor gains lib-2.0.jar lib-1.9.jar

ENGINES
  rust    candor-scan / candor-query    cargo install, or candor-rust/install.sh
  jvm     the candor-java jar           ~/.candor/*.jar, or CANDOR_JAVA_JAR
  ts      candor-ts                     runs via npx when not installed
  swift   candor-swift                  build from the candor-swift repo

Docs: candor.poly.io   ·   Verify an install: candor doctor
H
    exit 0;;
  -V|--version)
    # version details for every locally-installed engine, one aligned table (fast paths
    # only — no npx; `candor doctor` does the full check incl. the npx fallback). Exit 0.
    { echo "candor $UMBRELLA_VERSION (umbrella)"
      rb="$(rust_bin candor-scan 2>/dev/null)" && "$rb" --version 2>/dev/null | head -1
      rb="$(rust_bin candor-query 2>/dev/null)" && "$rb" --version 2>/dev/null | head -1
      if have candor-java; then candor-java --version 2>/dev/null | head -1
      elif [ -x "$CDBIN/candor-java" ]; then "$CDBIN/candor-java" --version 2>/dev/null | head -1
      else jar="${CANDOR_JAVA_JAR:-$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)}"
           { [ -n "$jar" ] && [ -f "$jar" ]; } && java -jar "$jar" --version 2>/dev/null | head -1; fi
      have candor-ts && candor-ts --version 2>/dev/null | head -1
      have candor-swift && candor-swift --version 2>/dev/null | head -1
    } | awk '{ rest=""; for (i=3;i<=NF;i++) rest=rest (i>3?" ":"") $i; printf "%-14s %-8s %s\n", $1, $2, rest }'
    exit 0;;
  outdated|check)
    # Ask each engine's release channel whether a newer version exists. EXPLICIT network (user-invoked,
    # never a silent beacon) — same provenance as `update`. Classifies per engine: up to date / a POINT
    # update within your spec line (safe — same spec, `candor update` fetches it) / a NEW spec line (a
    # minor bump — adopt it by upgrading the umbrella so the whole family moves together).
    have curl || die "outdated needs curl on PATH."
    echo "candor: querying release channels (github.com · crates.io · npm) — explicit check, no telemetry."
    echo ""
    printf "  %-7s %-12s %-12s %s\n" "ENGINE" "INSTALLED" "LATEST" "STATUS"
    # installed versions (build number = field 2 of the --version line)
    ivjvm=""; if have candor-java; then ivjvm=$(candor-java --version 2>/dev/null | head -1 | awk '{print $2}')
      elif [ -x "$CDBIN/candor-java" ]; then ivjvm=$("$CDBIN/candor-java" --version 2>/dev/null | head -1 | awk '{print $2}'); fi
    ivrust=""; rb="$(rust_bin candor-scan 2>/dev/null)" && ivrust=$("$rb" --version 2>/dev/null | head -1 | awk '{print $2}')
    ivts=""; tsnpx=""; if have candor-ts; then ivts=$(candor-ts --version 2>/dev/null | head -1 | awk '{print $2}'); elif have node; then tsnpx=1; fi
    ivsw=""; have candor-swift && ivsw=$(candor-swift --version 2>/dev/null | head -1 | awk '{print $2}')
    # latest from each channel (best-effort; a channel we can't reach says so, never a false "up to date")
    ljvm=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-java/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lrust=$(curl -fsSL -H "User-Agent: candor-cli" "https://crates.io/api/v1/crates/candor-scan" 2>/dev/null | sed -n 's/.*"max_stable_version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lts=$(curl -fsSL "https://registry.npmjs.org/candor-ts/latest" 2>/dev/null | sed -n 's/.*"version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lsw=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-swift/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
    # refresh the nudge cache from this explicit check (so an opted-in notice reflects the latest)
    { echo "checked=$(date +%s 2>/dev/null || echo 0)"; echo "jvm=$ljvm"; echo "rust=$lrust"; echo "ts=$lts"; } > "$UPDATE_CACHE" 2>/dev/null || true
    # classify: same → up to date; same major.minor, higher patch → point update; higher minor → new spec line
    classify() { python3 - "$1" "$2" <<'PY'
import sys
inst, lat = sys.argv[1], sys.argv[2]
if not inst: print("not installed"); raise SystemExit
if not lat:  print("? channel unreachable"); raise SystemExit
def t(v): return tuple(int(x) for x in (v.split(".")+["0","0","0"])[:3])
i, l = t(inst), t(lat)
if l <= i: print("up to date")
elif l[:2] == i[:2]: print(f"point update {lat} available — same spec; `candor update`")
else: print(f"NEW spec line {lat} — `brew upgrade candor` to move the family")
PY
    }
    printf "  %-7s %-12s %-12s %s\n" "jvm"   "${ivjvm:--}"  "${ljvm:--}"  "$(classify "$ivjvm" "$ljvm")"
    printf "  %-7s %-12s %-12s %s\n" "rust"  "${ivrust:--}" "${lrust:--}" "$(classify "$ivrust" "$lrust")"
    if [ -n "$tsnpx" ]; then printf "  %-7s %-12s %-12s %s\n" "ts" "via npx" "${lts:--}" "always latest on run (npx)"
    else printf "  %-7s %-12s %-12s %s\n" "ts" "${ivts:--}" "${lts:--}" "$(classify "$ivts" "$lts")"; fi
    printf "  %-7s %-12s %-12s %s\n" "swift" "${ivsw:--}"   "${lsw:--}"   "$(classify "$ivsw" "$lsw")"
    echo ""
    echo "  A point update keeps your spec line (safe). A new spec line moves the whole family — take it"
    echo "  by upgrading the umbrella, so every engine stays in agreement (candor doctor verifies)."
    exit 0;;
  engines)
    # List the engines the umbrella manages: what each is, where it comes from, and its status.
    # A pure read — checks what's installed locally; makes NO network calls (unlike `update`).
    echo "candor engines — pinned to umbrella $UMBRELLA_VERSION"
    echo ""
    printf "  %-7s %-30s %s\n" "ENGINE" "STATUS" "SOURCE"
    jstat="not installed — run \`candor update\`"
    if have candor-java; then jstat="installed $(candor-java --version 2>/dev/null | head -1 | awk '{print $2}') (PATH)"
    elif [ -x "$CDBIN/candor-java" ]; then jstat="installed $("$CDBIN/candor-java" --version 2>/dev/null | head -1 | awk '{print $2}') (native)"
    elif ls "$HOME"/.candor/candor-java*-all.jar >/dev/null 2>&1; then jstat="installed (jar — needs a JVM)"; fi
    printf "  %-7s %-30s %s\n" "jvm" "$jstat" "github release — native binary (flagship)"
    rstat="not installed"; rb="$(rust_bin candor-scan 2>/dev/null)" && rstat="installed $("$rb" --version 2>/dev/null | head -1 | awk '{print $2}')"
    printf "  %-7s %-30s %s\n" "rust" "$rstat" "crates.io — cargo install (needs rust)"
    tstat="not installed"; if have candor-ts; then tstat="installed (global)"; elif have node; then tstat="available via npx (no install)"; else tstat="needs Node"; fi
    printf "  %-7s %-30s %s\n" "ts" "$tstat" "npm — runs via npx"
    sstat="not installed (optional)"; have candor-swift && sstat="installed $(candor-swift --version 2>/dev/null | head -1 | awk '{print $2}')"
    printf "  %-7s %-30s %s\n" "swift" "$sstat" "source build (macOS + swift)"
    echo ""
    echo "  candor update [jvm|rust|ts|swift ...]   fetch/refresh (all if none named)"
    echo "  candor doctor                           verify installs + spec agreement"
    exit 0;;
  install|update|upgrade)
    # Fetch/refresh the engines the umbrella manages, pinned to UMBRELLA_VERSION so the whole family
    # moves together (spec agreement guaranteed). The flagship JVM engine ships a native binary — no
    # JVM needed — which is what most people want; ts runs via npx with no install; rust/swift need a
    # toolchain and are set up only when one is present (else a note, never a hard failure).
    # Optional args select engines: `candor update jvm rust` (default: all).
    shift || true
    want() { [ $# -eq 0 ] && return 0; case " $REQ " in *" $1 "*) return 0;; *) return 1;; esac; }
    REQ="$*"
    have curl || die "install needs curl on PATH."
    mkdir -p "$CDBIN"
    # Provenance, stated up front — `update` is the ONE network action; the analysis itself never is.
    echo "candor: fetching from package registries only (github.com · crates.io · npm) — no candor server, no telemetry, no version-check ping."
    tag="v$UMBRELLA_VERSION"
    base="https://github.com/tombaldwin/candor-java/releases/download/$tag"
    # the native asset for this platform (GraalVM binaries: macos-arm64, linux-x64), else fall to the jar
    os=$(uname -s); arch=$(uname -m); asset=""
    case "$os:$arch" in
      Darwin:arm64)          asset="candor-macos-arm64" ;;
      Linux:x86_64|Linux:amd64) asset="candor-linux-x64" ;;
    esac
    echo "candor: syncing engines to $UMBRELLA_VERSION (the umbrella's pinned line)"
    # --- JVM engine (flagship) ---
    if want jvm; then
    if [ -n "$asset" ]; then
      echo "  jvm    → native binary ($asset), no JVM required"
      if curl -fsSL -o "$CDBIN/candor-java.tmp" "$base/$asset"; then
        chmod +x "$CDBIN/candor-java.tmp" && mv "$CDBIN/candor-java.tmp" "$CDBIN/candor-java"
        echo "         ✔ $("$CDBIN/candor-java" --version 2>/dev/null | head -1)"
      else
        rm -f "$CDBIN/candor-java.tmp"; echo "         ✘ download failed ($base/$asset)"
      fi
    else
      echo "  jvm    → no native binary for $os/$arch; fetching the jar (needs a JVM at runtime)"
      if curl -fsSL -o "$HOME/.candor/candor-java-$UMBRELLA_VERSION-all.jar.tmp" "$base/candor-java-$UMBRELLA_VERSION-all.jar"; then
        mv "$HOME/.candor/candor-java-$UMBRELLA_VERSION-all.jar.tmp" "$HOME/.candor/candor-java-$UMBRELLA_VERSION-all.jar"
        echo "         ✔ jar stashed in ~/.candor/"
      else
        rm -f "$HOME/.candor/candor-java-$UMBRELLA_VERSION-all.jar.tmp"; echo "         ✘ jar download failed"
      fi
    fi
    fi
    # --- TypeScript engine: zero-install via npx ---
    if want ts; then
      if have node; then echo "  ts     → runs via npx on demand (no install needed)"
      else echo "  ts     → install Node to enable the TypeScript engine (then it runs via npx)"; fi
    fi
    # --- Rust engine: needs a toolchain; set up only when present ---
    if want rust; then
      if have cargo; then
        echo "  rust   → cargo install candor-scan candor-query"
        cargo install -q candor-scan candor-query 2>/dev/null && echo "         ✔ $(candor-scan --version 2>/dev/null | head -1)" || echo "         ✘ cargo install failed (see: cargo install candor-scan candor-query)"
      else
        echo "  rust   → skipped (no Rust toolchain; install rustup to enable the Rust engine)"
      fi
    fi
    # --- Swift engine: macOS + toolchain, source build ---
    if want swift; then
      if [ "$os" = Darwin ] && have swift; then
        echo "  swift  → build from the candor-swift repo (macOS): swift build -c release"
      else
        echo "  swift  → optional (macOS + Swift toolchain; build from the candor-swift repo)"
      fi
    fi
    # We're already online — refresh the version cache and report any release beyond the pin (a point
    # release is spec-compatible; a new line moves the family). Adopt either by moving the umbrella.
    refresh_update_cache
    newest=$(newest_beyond_pin)
    if [ -n "$newest" ]; then
      echo ""
      echo "  ↑ $(newer_kind "$newest") is available on the channel, beyond the pinned $UMBRELLA_VERSION."
      echo "    Adopt it by moving the whole family together: brew upgrade candor"
    fi
    echo ""
    exec "$0" doctor;;
  doctor)
    # one-shot install check: each engine's presence + version, and SPEC agreement (the interop
    # contract — matching `spec` matters; build versions may differ per the versioning ladder).
    # If update-check is opted in and the cache is stale, this is where the (once/day) refresh happens.
    maybe_refresh_update_cache
    rc=0; specs=""
    report() { # $1 name, $2 version-line-or-empty, $3 hint
      if [ -n "$2" ]; then
        printf "  %-14s %s\n" "$1" "$2"
        s=$(printf "%s" "$2" | sed -n 's/.*(spec \([0-9.]*\)).*/\1/p'); [ -n "$s" ] && specs="$specs $s"
      else
        printf "  %-14s MISSING — %s\n" "$1" "$3"; rc=1
      fi
    }
    rb="$(rust_bin candor-scan 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust scan" "$v" "cargo install candor-scan (or candor-rust/install.sh)"
    rb="$(rust_bin candor-query 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust query" "$v" "cargo install candor-query"
    if have candor-java; then v=$(candor-java --version 2>/dev/null | head -1)
    elif [ -x "$CDBIN/candor-java" ]; then v=$("$CDBIN/candor-java" --version 2>/dev/null | head -1)
    else jar="${CANDOR_JAVA_JAR:-$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)}"
         { [ -n "$jar" ] && [ -f "$jar" ]; } && v=$(java -jar "$jar" --version 2>/dev/null | head -1) || v=""; fi
    report "jvm" "$v" "run \`candor update\` to fetch it"
    if have candor-ts; then v=$(candor-ts --version 2>/dev/null | head -1)
    else v=$(npx -y candor-ts --version 2>/dev/null | head -1); [ -n "$v" ] && v="$v (via npx)"; fi
    report "ts" "$v" "npx -y candor-ts (needs node) or npm i -g candor-ts"
    if have candor-swift; then report "swift" "$(candor-swift --version 2>/dev/null | head -1)" ""
    else printf "  %-14s not installed (optional — build from candor-swift)\n" "swift"; fi
    u=$(printf "%s\n" $specs | sort -u | grep -c .)
    if [ "$u" -gt 1 ]; then
      echo "  ✘ SPEC DRIFT: installed engines declare different spec versions ($(printf "%s" "$specs" | tr ' ' ',' | sed 's/^,//')) — upgrade the stragglers."; rc=1
    elif [ "$u" -eq 1 ]; then
      echo "  ✔ all installed engines agree on spec $(printf "%s\n" $specs | sort -u)"
    fi
    exit $rc;;
  init)
    # candor init — stand up the effect gate in one command (engine picked by manifest):
    #   1. scan the project                         → .candor/report*
    #   2. PROPOSE a starter policy from what the code already does → .candor/arch.policy
    #   3. record the baseline (the regression ratchet)             → .candor/baseline*
    #   4. wire .candor/config (policy + baseline keys)
    # Existing files are never clobbered. Review arch.policy (every proposed rule currently
    # passes), commit .candor/, and add the gate to CI (see the adopt/ dir for templates).
    shift; idir="${1:-.}"
    [ -d "$idir" ] || die "init: '$idir' is not a directory"
    mkdir -p "$idir/.candor"
    echo "candor init — $idir"
    # 1. scan (in-process, not exec'd)
    ( cd "$idir" && CANDOR_DISPATCH_NOEXEC=1 route_scan . ) || die "init: the scan failed — fix that first"
    # the main report: newest report*.json that isn't a sidecar
    rep="$(ls -t "$idir"/.candor/report*.json 2>/dev/null | grep -vE 'callgraph|hierarchy' | head -1)"
    [ -n "$rep" ] || die "init: the scan wrote no report under $idir/.candor"
    echo "  ✔ scanned → ${rep#"$idir"/}"
    # 2. propose the policy (the inference tool lives beside this script in the umbrella repo)
    tooldir="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
    if [ -f "$idir/.candor/arch.policy" ]; then
      echo "  · .candor/arch.policy exists — kept (delete it and re-run to re-propose)"
    elif [ -x "$tooldir/adopt/candor-init" ] || [ -f "$tooldir/adopt/candor-init" ]; then
      python3 "$tooldir/adopt/candor-init" "$rep" --out "$idir/.candor/arch.policy" >/dev/null 2>&1         && echo "  ✔ proposed .candor/arch.policy (every rule currently passes — review, keep what matches intent)"         || echo "  · policy proposal skipped (the inference tool could not read the report)"
    else
      echo "  · policy proposal skipped (adopt/candor-init not found beside the dispatcher)"
    fi
    # 3. the baseline: report* → baseline* (never clobber)
    if ls "$idir"/.candor/baseline*.json >/dev/null 2>&1; then
      echo "  · baseline exists — kept (regenerating a baseline is a deliberate act: copy report* → baseline* yourself)"
      bl="$(ls "$idir"/.candor/baseline*.json 2>/dev/null | grep -vE 'callgraph|hierarchy' | head -1)"
    else
      bl=""
      for f in "$idir"/.candor/report*.json; do
        b="$(dirname "$f")/$(basename "$f" | sed 's/^report/baseline/')"
        cp "$f" "$b"
        case "$b" in *callgraph*|*hierarchy*) ;; *) bl="$b";; esac
      done
      echo "  ✔ baseline recorded → ${bl#"$idir"/} (an existing effectful function widening its reach now fails the gate)"
    fi
    # 4. wire the config (append missing keys only)
    cfg="$idir/.candor/config"
    touch "$cfg"
    grep -q "^policy" "$cfg" 2>/dev/null || { [ -f "$idir/.candor/arch.policy" ] && printf 'policy .candor/arch.policy\n' >> "$cfg" && echo "  ✔ config: policy wired"; }
    grep -q "^baseline" "$cfg" 2>/dev/null || { [ -n "$bl" ] && printf 'baseline %s\n' ".candor/$(basename "$bl")" >> "$cfg" && echo "  ✔ config: baseline wired"; }
    echo ""
    echo "Next: review .candor/arch.policy, commit .candor/ (config, arch.policy, baseline*),"
    echo "and gate CI with:  candor scan . --gate-json verdict.json   (exit 1 on a violation)."
    echo "CI templates: the adopt/ dir of the candor repo (GitHub Action, or a pipeline step)."
    exit 0;;
  scan) shift; route_scan "$@";;
  *)    route_scan "$@";;
esac
