#!/usr/bin/env bash
# candor — the umbrella dispatcher (candor-spec §3.3.1). ONE `candor` command across every language.
#
#   • a QUERY (where/path/show/…) is routed by the DISCOVERED report's backend — the filename tail
#     `.JS` → TypeScript, `.jvm` → Java, `.Swift` → Swift, and everything else (Rust's `.scan` syntactic
#     backend plus the nightly-lint crate-types `.lib`/`.Executable`/`.Rlib`/…) → Rust.
#   • a SCAN (`candor scan .`, or `candor <dir>`) is routed by the project's manifest — Cargo.toml → Rust,
#     package.json / tsconfig.json → TypeScript, build.gradle / pom.xml / *.java → Java, Package.swift → Swift.
#
# It execs the matching engine's QUALIFIED CLI (candor-query, candor-ts-query, candor-java, candor-swift) —
# they all speak the same §3.3.1 grammar, so every flag and verb passes straight through. This owns the bare
# `candor` name so four language packages don't fight over it, and it NEVER guesses silently: an ambiguous
# project (or a missing engine) is a loud, actionable error, not a wrong-engine run.
#
# Set CANDOR_DISPATCH_DRYRUN=1 to print the resolved command instead of running it (used by the tests).

CDBIN="${CANDOR_CACHE:-$HOME/.candor}/bin"   # where candor-rust/install.sh stashes candor-scan + candor-query
UMBRELLA_VERSION="0.27.0"                    # the umbrella's OWN version (brew formula / --version row) — bumpable for CLI-only patches
ENGINE_PIN="0.26.0"                          # the engine release line `candor update` fetches — MUST move with every engine release (release-preflight [3] gates it; it lagged at 0.18.0 through 0.23.1 and shipped 0.18 engines under a 0.23 umbrella)
QUERY_VERBS=" show where callers map containment diff reachable impact blindspots gains path tour whatif fix fix-gate unverified rewire parsepolicy agents gate privacy-manifest "
EFFECTS="Net Fs Db Llm Exec Env Clock Ipc Log Rand Clipboard Unknown"   # the §6 effect vocabulary (kept in step with the completions + `candor effects`)

die()  { echo "candor: $*" >&2; exit 2; }
# A SIDECAR IS NOT A REPORT. Discovery globs `.candor/report*.json`, and every engine writes companion
# files beside the primary report; if one is mistaken for a second engine's report, every bare query
# dead-ends with "multiple engines' reports … disambiguate".
#
# THIS LIST EXISTED IN FIVE PLACES AND `.locs.json` WAS IN NONE OF THEM. candor-ts writes it on every
# scan, so a TS scan broke every subsequent bare verb — including the command the scan itself prints as
# its suggested next step — and `candor init` in a polyglot tree baselined the SIDECAR and emitted a
# nonsense CI gate line attributed to the wrong engine. Five copies of a rule is five places to forget
# the sixth suffix, which is what happened, so there is now one.
is_sidecar() {
  case "$1" in
    *.callgraph.json|*.hierarchy.json|*.calibrated.json|*.gate.json|*.locs.json|*.encountered-*.json) return 0;;
  esac
  return 1
}

have() { command -v "$1" >/dev/null 2>&1; }

# Validate an effect token against the §6 vocabulary; die with a did-you-mean on a miss. This closes the
# silent-empty trap the persona audit found: `where Network` / `where fs` / `where Banana` used to reach the
# engine, match nothing, and print a FALSE all-clear ("nothing performs it") — dangerous for a tool whose
# promise is "trust that nothing reaches the network". A typo is now a loud error, not a wrong reassurance.
check_effect() {
  local want="$1" e lc
  for e in $EFFECTS; do [ "$e" = "$want" ] && return 0; done   # a known §6 effect — fine
  # ONLY a case-insensitive EXACT match to a known effect is caught here — an unambiguous wrong-CASE typo
  # (`net`→Net, `fs`→Fs) — with a helpful did-you-mean. EVERY OTHER unknown name is DEFERRED to the engine,
  # which validates report-aware: the engines accept a spec-extension effect PRESENT in the report and error
  # only when the name is NEITHER known NOR present. The umbrella can't see the report, so it must NOT
  # hard-reject an unknown name (that blocked a valid extension-effect query — e.g. `Netlify` once matched a
  # `Net` prefix heuristic — and diverged from all three engines; review finding). A real typo like `Network`
  # still errors, just from the (report-aware) engine rather than here.
  lc=$(printf '%s' "$want" | tr '[:upper:]' '[:lower:]')
  for e in $EFFECTS; do [ "$(printf '%s' "$e" | tr '[:upper:]' '[:lower:]')" = "$lc" ] && die "unknown effect '$want' — did you mean \`$e\`? Effect names are capitalised. (\`candor effects\` lists them.)"; done
  return 0   # unknown, but not a wrong-case known effect → defer to the engine's report-aware validation
}
# Echo the Nth positional argument, skipping flags AND the values of value-taking flags (--report/--policy/
# --gate-json) so `where --report r.json Net` still validates Net, not r.json.
nth_positional() {
  local n="$1"; shift; local skip=0 c=0 a
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in --report|--policy|--gate-json) skip=1;; -*) ;; *) c=$((c+1)); [ "$c" = "$n" ] && { echo "$a"; return; };; esac
  done
}

# Resolve a path through symlinks WITHOUT relying on `realpath` (absent on stock macOS). Prefers python3;
# falls back to a readlink loop. Used to find the real bin/candor so the hook scripts resolve through the
# brew symlink (/opt/homebrew/bin/candor → …/Cellar/candor/<v>/bin/candor).
resolve_path() {
  if have python3; then python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; return; fi
  local p="$1" d
  while [ -L "$p" ]; do
    local t; t="$(readlink "$p")"
    case "$t" in /*) p="$t";; *) d="$(cd "$(dirname "$p")" && pwd)"; p="$d/$t";; esac
  done
  d="$(cd "$(dirname "$p")" && pwd)"; echo "$d/$(basename "$p")"
}
# The dir holding the Claude-Code hook scripts (stop-hook.sh …), searched in order: $CANDOR_HOOK_DIR
# (explicit override) → <scriptdir>/../integrations/claude-code (dev/source checkout) →
# <scriptdir>/../share/candor/hooks (brew install layout). <scriptdir> = dir of the RESOLVED bin/candor.
# Echoes the dir containing stop-hook.sh, or nothing.
hook_dir() {
  local cand
  if [ -n "${CANDOR_HOOK_DIR:-}" ] && [ -f "$CANDOR_HOOK_DIR/stop-hook.sh" ]; then echo "$CANDOR_HOOK_DIR"; return; fi
  local self scriptdir; self="$(resolve_path "$0")"; scriptdir="$(dirname "$self")"
  for cand in "$scriptdir/../integrations/claude-code" "$scriptdir/../share/candor/hooks"; do
    [ -f "$cand/stop-hook.sh" ] && { (cd "$cand" && pwd); return; }
  done
}
# a Rust raw bin lives on PATH or under ~/.candor/bin
rust_bin() { if have "$1"; then echo "$1"; elif [ -x "$CDBIN/$1" ]; then echo "$CDBIN/$1"; else return 1; fi; }
# run (or, in dry-run, just announce) the resolved engine command
run() {
  if [ -n "${CANDOR_DISPATCH_DRYRUN:-}" ]; then echo "WOULD-RUN: $*"; exit 0; fi
  if [ -n "${CANDOR_DISPATCH_NOEXEC:-}" ]; then "$@"; return $?; fi
  exec "$@"
}

# candor-java resolution, in preference order: a `candor-java` launcher on PATH → the native binary the
# umbrella stashes (`candor update`, no JVM needed) → `java -jar <jar>` (CANDOR_JAVA_JAR or a stashed jar).
run_java() {
  # each tier RETURNS after running (under NOEXEC run() returns; under exec it never gets here) — without
  # the returns, NOEXEC callers (init) fall through every tier and re-run the engine / die after success.
  if have candor-java; then run candor-java "$@"; return $?; fi
  [ -x "$CDBIN/candor-java" ] && { run "$CDBIN/candor-java" "$@"; return $?; }
  local jar="${CANDOR_JAVA_JAR:-}"
  [ -n "$jar" ] || jar="$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)"
  [ -n "$jar" ] && [ -f "$jar" ] || die "a Java target, but no candor-java engine — run \`candor update\` to fetch it (or set CANDOR_JAVA_JAR)."
  # Short interactive scans waste wall time on C2 JIT that never pays off; C1-only is ~20% faster there,
  # while large batch scans need C2 (the hot analysis loop). FAIL-SAFE: prefer C1 only for a provably small
  # target directory. Override via CANDOR_JAVA_OPTS. (Mirrors the standalone bin/candor-java launcher.)
  local jopts="${CANDOR_JAVA_OPTS-}"
  if [ -z "${CANDOR_JAVA_OPTS+set}" ]; then
    local jt=""; local a
    for a in "$@"; do case "$a" in -*) ;; *) jt="$a"; break;; esac; done
    if [ -n "$jt" ] && [ -d "$jt" ] && [ "$(find "$jt" -name '*.class' 2>/dev/null | head -512 | wc -l | tr -d ' ')" -lt 500 ]; then
      jopts="-XX:TieredStopAtLevel=1"
    fi
  fi
  run java $jopts -jar "$jar" "$@"
}

# ---- update notifications (OPT-IN, off by default; privacy: the network CHECK rides only the admin
# commands update/outdated/doctor, throttled to once/day and CACHED; the notice itself is a local cache
# read, so it never adds a network call to scan/query/gate). Enable: `candor config update-check on`. ----
SETTINGS="${CANDOR_CACHE:-$HOME/.candor}/settings"
UPDATE_CACHE="${CANDOR_CACHE:-$HOME/.candor}/update-check"
setting() { [ -f "$SETTINGS" ] && sed -n "s/^$1=//p" "$SETTINGS" | head -1; }
# refresh the cached "latest per channel" — the ONE network action here; callers gate it on opt-in+staleness
refresh_update_cache() {
  have curl || return 0
  local ljvm lrust lts now
  ljvm=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-java/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
  lrust=$(curl -fsSL -H "User-Agent: candor-cli" "https://crates.io/api/v1/crates/candor-scan" 2>/dev/null | sed -n 's/.*"max_stable_version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
  lts=$(curl -fsSL "https://registry.npmjs.org/candor-ts/latest" 2>/dev/null | sed -n 's/.*"version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
  now=$(date +%s 2>/dev/null || echo 0)
  mkdir -p "$(dirname "$UPDATE_CACHE")"
  { echo "checked=$now"; echo "jvm=$ljvm"; echo "rust=$lrust"; echo "ts=$lts"; } > "$UPDATE_CACHE" 2>/dev/null || true
}
# on an admin command, when opted in and the cache is >24h old, refresh it (network). Silent otherwise.
maybe_refresh_update_cache() {
  [ "$(setting update-check)" = on ] || return 0
  local checked=0 now
  [ -f "$UPDATE_CACHE" ] && checked=$(sed -n 's/^checked=//p' "$UPDATE_CACHE" | head -1)
  now=$(date +%s 2>/dev/null || echo 0)
  [ $((now - ${checked:-0})) -ge 86400 ] && refresh_update_cache
}
# the newest cached channel version greater than the umbrella pin (empty if none / no cache) — no network.
newest_beyond_pin() {
  [ -f "$UPDATE_CACHE" ] || return 0
  python3 - "$UPDATE_CACHE" "$ENGINE_PIN" <<'PY' 2>/dev/null || true
import sys
cache, pin = sys.argv[1], sys.argv[2]
def t(v):
    try: return tuple(int(x) for x in (v.split(".")+["0","0","0"])[:3])
    except Exception: return (0,0,0)
latest = {}
for line in open(cache):
    if "=" in line and not line.startswith("checked"):
        k,v = line.strip().split("=",1)
        if v: latest[k]=v
newer = [v for v in latest.values() if t(v) > t(pin)]
if newer: print(sorted(newer, key=t)[-1])
PY
}
# describe a version beyond the pin as a spec-compatible point release or a new line
newer_kind() { case "$1" in "${ENGINE_PIN%.*}".*) echo "a point release ($1, spec-compatible)";; *) echo "a new version ($1)";; esac; }
# print a one-line notice FROM CACHE (no network) if a newer version than the pin is known. Silent when
# opted out, no cache, or up to date. stderr, so it never corrupts --json on stdout.
show_update_notice() {
  [ "$(setting update-check)" = on ] || return 0
  [ -n "${CANDOR_DISPATCH_DRYRUN:-}" ] && return 0
  local newest; newest=$(newest_beyond_pin)
  [ -n "$newest" ] || return 0
  echo "candor: $(newer_kind "$newest") is available — \`candor outdated\` for detail, \`brew upgrade candor\` to update." >&2
}

# Sniff a token-less report FILE's backend from its §2.1 envelope (candor.toolchain / candor.version;
# meta.* for older rust shapes): jdk-* → jvm, swiftsyntax|candor-swift-* → Swift, node-*|candor-ts-* →
# JS, stable/nightly/scan-* → the open remainder (rust). Unreadable/absent envelope → JS (candor-ts is
# the only engine whose NATIVE primary shape is token-less, so it's the honest unreadable default).
sniff_backend() {
  python3 - "$1" 2>/dev/null <<'PYEOF' || echo JS
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    env = d.get("candor") or d.get("meta") or {}
    tc = str(env.get("toolchain", "")); v = str(env.get("version", ""))
except Exception:
    print("JS"); raise SystemExit
if tc.startswith("jdk"): print("jvm")
elif tc == "swiftsyntax" or v.startswith("candor-swift"): print("Swift")
elif tc.startswith("node") or v.startswith("candor-ts"): print("JS")
else: print("scan")
PYEOF
}

# Resolve the .candor/config `policy` key (walk up from CWD), anchored to the config HOME dir (§3.4 —
# the dir holding .candor/). Echoes the resolved path if the file exists. Lets the policy-consuming query
# verbs (fix/fix-gate/whatif/unverified) honor the config like the scan gate already does, so the fix-gate
# loop the violation output points at works without the user re-passing --policy.
config_policy() {
  local d="$PWD" cfg=""
  while :; do [ -f "$d/.candor/config" ] && { cfg="$d/.candor/config"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
  [ -n "$cfg" ] || return 0
  local val; val="$(sed -n 's/^policy[[:space:]][[:space:]]*//p' "$cfg" | head -1)"
  [ -n "$val" ] || return 0
  case "$val" in /*) ;; *) val="$(dirname "$(dirname "$cfg")")/$val";; esac
  [ -f "$val" ] && echo "$val"
}

# ---- QUERY: route by the discovered report's backend ---------------------------------------------------
route_query() {
  local verb="$1"; shift
  # validate the effect positional up front (where <Effect> · path/fix <fn> <Effect>) so a typo'd or
  # wrong-case effect name is a loud error, never a silent false "nothing performs it" (persona-audit fix).
  case "$verb" in
    where)           ve="$(nth_positional 1 "$@")"; [ -n "$ve" ] && check_effect "$ve";;
    path|fix|whatif) ve="$(nth_positional 2 "$@")"; [ -n "$ve" ] && check_effect "$ve";;  # all take <fn> <Effect>
  esac
  # config-driven policy: a policy-consuming verb honors .candor/config's `policy` key (the one `candor
  # init` writes) when no --policy/CANDOR_POLICY is given — so `candor fix-gate` after a violation works
  # like the scan gate, not "a policy is required".
  case " $verb " in *" fix "*|*" fix-gate "*|*" whatif "*|*" unverified "*)
    if [ -z "${CANDOR_POLICY:-}" ]; then
      case " $* " in *" --policy "*) ;; *) cp="$(config_policy)"; [ -n "$cp" ] && export CANDOR_POLICY="$cp";; esac
    fi;;
  esac
  # honor an explicit --report <loc>; else discover a `.candor/` ancestor from $PWD (the §3.3.1 rule)
  local a prev="" loc=""
  for a in "$@"; do [ "$prev" = "--report" ] && loc="$a"; prev="$a"; done
  # gains/diff take TWO positional report locators (<current> <baseline>) — discovery does NOT apply. Pick the
  # engine from the FIRST positional so `candor gains new.json old.json` works from ANY dir; before this the
  # dispatcher tried to discover a `.candor/` ancestor to choose the backend and died "no report — run scan"
  # even though both reports were named explicitly (#10). --report still wins if given.
  case "$verb" in
    gains|diff) if [ -z "$loc" ]; then for a in "$@"; do case "$a" in -*) ;; *) loc="$a"; break;; esac; done; fi;;
  esac
  # Resolve the locator to the report FILES by the ONE §3.3.1 rule (the same rule every engine applies):
  # a DIRECTORY → its `.candor/report` family; a `.json` path → that single report file; anything else →
  # a bare PREFIX (`<prefix>.<pkg>.<backend>.json`). No --report → discover a `.candor/` ancestor. The old
  # code always globbed `<dir>/report.*.json`, so a --report naming a non-`report`-basename prefix or a
  # direct .json file died with "no report" — a locator every engine accepts but the dispatcher refused.
  local files=() famprefix=""
  if [ -n "$loc" ]; then
    if [ -d "$loc" ]; then famprefix="$loc/.candor/report"; files=("$famprefix".*.json)
    elif [ "${loc%.json}" != "$loc" ] && [ -f "$loc" ]; then files=("$loc")
    else famprefix="$loc"; files=("$loc".*.json); fi
  else
    local d="$PWD" base=""
    while :; do [ -d "$d/.candor" ] && { base="$d/.candor/report"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
      # NO REPORT? SCAN, don't lecture. A scan is cheap (every engine is syntactic except the JVM one,
      # which needs bytecode and says so), non-destructive, and is the ONLY thing the user could have done
      # with the instruction we used to print. Making them read it, retype it and come back is a dead end
      # with extra steps — and it is exactly what stood between `brew install candor` and an answer.
      #
      # LOUD, never silent: it says what it is doing and that it wrote `.candor/`, because a verb that
      # quietly creates files in your repo is its own surprise. CANDOR_NO_AUTOSCAN=1 restores the refusal
      # (for CI that should fail rather than scan).
      if [ -z "$base" ] && [ -z "${CANDOR_NO_AUTOSCAN:-}" ] && [ -z "${CANDOR_DISPATCH_DRYRUN:-}" ]; then
        _al="$(detect_langs "$PWD")"
        case "$_al" in
          rust|ts|java|swift)
            if engine_present "$_al" || autofetch_engine "$_al"; then
              echo "candor: no report here yet — scanning first (writes .candor/), then answering." >&2
              ( CANDOR_AUTOSCAN=1 route_scan "$PWD" >&2 ) || die "the scan failed — see above; nothing to answer from."
              d="$PWD"; while :; do [ -d "$d/.candor" ] && { base="$d/.candor/report"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
            fi;;
        esac
      fi
    [ -n "$base" ] || die "no report — run \`candor scan\` first, or pass --report <locator>. (no .candor/ from $PWD upward)"
    famprefix="$base"; files=("$base".*.json)
  fi


  # the distinct backends present (the token before .json), excluding EVERY non-report sidecar the
  # engines write beside the reports — not just the callgraph/hierarchy pair: candor-scan also writes
  # `report.calibrated.json` + `report.encountered-<crate>.json` ledgers and `--gate-json` verdicts,
  # which previously counted as phantom "engines" and made the dispatcher refuse its own scan output
  # ("multiple engines' reports … disambiguate"). Same discrimination rule as the engines' loaders.
  local f b uniq="" n=0
  for f in "${files[@]}"; do
    [ -e "$f" ] || continue
    is_sidecar "$f" && continue
    b="${f%.json}"
    case "$(basename "$b")" in
      *.*) b="${b##*.}";;
      # a token-less `<name>.json` carries no backend in its NAME (candor-ts's primary shape — but
      # ALSO any engine's `--json > baseline.json` style direct output, which the old JS assumption
      # misrouted; max-review find). Sniff the §2.1 envelope's `candor.toolchain` instead: jdk-* →
      # java, swiftsyntax → swift, node-* → ts; anything else (stable/nightly/unreadable) follows
      # the family rule's open remainder → rust falls out of the sniffer's default below.
      *)   b="$(sniff_backend "$f")";;
    esac
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  done
  # a family prefix may ALSO carry the token-less `<prefix>.json` (the candor-ts shape) — the
  # `<prefix>.*.json` glob can never match it (no inner dot segment), so probe it directly. This runs
  # UNCONDITIONALLY (not only when n==0): a ts report.json beside a tokened engine's reports must
  # trip the multiple-engines ambiguity check, never be silently shadowed (max-review find).
  if [ -n "$famprefix" ] && [ -f "$famprefix.json" ]; then
    b="$(sniff_backend "$famprefix.json")"
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  fi
  [ "$n" -ge 1 ] || die "no report at ${loc:-the discovered .candor/} — run \`candor scan\` first, or check the --report locator."
  [ "$n" -eq 1 ] || die "multiple engines' reports at ${loc:-the discovered .candor/} (${uniq# }) — disambiguate with --report <locator>."

  # freshness note (daily-use trap: query answers silently drift after edits). One stderr line when any
  # source file is newer than the report; discovery-only (an explicit --report is a deliberate pin), and
  # a single -quit find so it stays fast on big repos. CANDOR_NO_FRESHNESS=1 silences it.
  if [ -z "$loc" ] && [ -z "${CANDOR_NO_FRESHNESS:-}" ]; then
    local repfile="" newer=""
    for f in "${files[@]}"; do [ -e "$f" ] && { repfile="$f"; break; }; done
    [ -z "$repfile" ] && [ -f "$famprefix.json" ] && repfile="$famprefix.json"
    if [ -n "$repfile" ]; then
      local root; root="$(dirname "$(dirname "$repfile")")"
      newer=$(find "$root" \( -name .git -o -name .candor -o -name node_modules -o -name target -o -name build -o -name .build -o -name dist \) -prune -o \
        -type f \( -name '*.rs' -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' -o -name '*.java' -o -name '*.kt' -o -name '*.scala' -o -name '*.swift' \) \
        -newer "$repfile" -print -quit 2>/dev/null)
      [ -n "$newer" ] && echo "candor: note — source has changed since this report (${newer#"$root"/} is newer); re-run \`candor scan\` for current answers." >&2
    fi
  fi

  # TS/Java/Swift use FIXED backend tokens; Rust owns the open remainder — `scan` (syntactic backend) plus
  # the nightly-lint crate-types (`lib`, `Executable`, `Rlib`, `Dylib`, `bin`, …). So match the three fixed
  # tokens explicitly and route everything else to candor-query, exactly as the Rust engine's own
  # report-backend detection does (any non-JS/jvm/Swift, non-sidecar report is a Rust report).
  # CAPABILITY, not just presence. Refuse HERE — with the engines that do implement the verb — rather than
  # handing an engine a verb it lacks and letting it misread the argument.
  local supported arm; supported="$(verb_engines "$verb")"; arm="$(backend_arm "${uniq# }")"
  if [ -n "$supported" ]; then
    case " $supported " in
      *" $arm "*) ;;
      *) local names="" t
         for t in $supported; do names="$names, $(engine_name "$t")"; done
         die "$(engine_name "${uniq# }") does not implement \`$verb\` — the engine(s) that do: ${names#, }. (\`candor --help\` lists what this project's engine supports.)";;
    esac
  fi

  case "${uniq# }" in
    JS)    if have candor-ts-query; then run candor-ts-query "$verb" "$@"
           elif have node; then run npx -y -p "candor-ts@$ENGINE_PIN" candor-ts-query "$verb" "$@"
           else die "a TypeScript report, but neither candor-ts-query nor Node is installed — install Node (the engine then runs via npx)."; fi;;
    jvm)   run_java "$verb" "$@";;
    Swift) local c; c=$(rust_bin candor-swift) || die "a Swift report, but candor-swift isn't installed — run \`candor update swift\` (macOS)."; run "$c" "$verb" "$@";;
    *)     local c; c=$(rust_bin candor-query) || die "a Rust report, but candor-query isn't installed — install candor-rust."; run "$c" "$verb" "$@";;
  esac
}

# ---- SCAN: route by the project manifest ---------------------------------------------------------------
# echo the languages detected in <dir> (space-separated among: rust ts java swift), no die. Shared by
# route_scan and init, so both see the manifest set the same way.
detect_langs() {
  local dir="$1" langs="" g jm=1
  for g in "$dir/build.gradle" "$dir/build.gradle.kts" "$dir/settings.gradle" "$dir/settings.gradle.kts" "$dir/pom.xml"; do [ -f "$g" ] && jm=0; done
  if [ "$jm" = 1 ]; then for g in "$dir"/*.java; do [ -e "$g" ] && { jm=0; break; }; done; fi
  [ -f "$dir/Cargo.toml" ] && langs="$langs rust"
  { [ -f "$dir/package.json" ] || [ -f "$dir/tsconfig.json" ]; } && langs="$langs ts"
  [ "$jm" = 0 ] && langs="$langs java"
  [ -f "$dir/Package.swift" ] && langs="$langs swift"
  echo "${langs# }"
}
# WHICH ENGINES IMPLEMENT A VERB — the question `engine_present` cannot answer.
#
# `engine_present` answers "is it installed?", never "does it support this?", and both directions failed
# without this table. `candor privacy-manifest` said "unknown action" because the umbrella did not know
# candor-swift has it; worse, `candor show <fn>` on a Swift project reached the engine, which lacks `show`,
# and reported "no such path: <fn>" — BLAMING THE USER'S ARGUMENT for a capability gap. That is the exact
# inverse of the "failures carry remedies, nothing dead-ends" rule the rest of this CLI follows.
#
# MEASURED from each engine's own CLI, not assumed — `candor-ts-query` with no args, candor-java's
# `Query.java`, candor-query's dispatch, candor-swift's `main.swift`. The asymmetries are real and each one
# would misroute without a row here: java has no `parsepolicy`, ts has no `rewire`, only rust has `agents`,
# and candor-swift implements 9 of the 21.
#
# The tokens are the report BACKEND tokens `route_query` already resolves (JS · jvm · rust · Swift), so the
# table is keyed on the same thing the dispatch is.
# MEASURED, and two rows were measured WRONG on the first cut (2026-08-04) — a review caught them:
#   · `parsepolicy` omitted jvm — java implements it and answers with the parsed JSON.
#   · `agents` listed rust only — candor-ts implements it too. I had probed `scan.mjs`, which does not
#     have it, when the verb lives in `query.mjs`.
# Both produced FALSE REFUSALS: the dispatcher told a user their engine lacked a verb it has, which is
# the exact bug this table exists to fix, committed by the fix. The lesson is not "measure" — I did —
# it is that a verb must be probed on the binary the DISPATCHER would route it to, in a directory where
# a report exists, because otherwise every verb fails identically on report discovery before the engine
# ever dispatches it. That is how the first re-measurement reported `where` as absent from rust.
verb_engines() {
  case "$1" in
    gains|path|tour|fix|fix-gate|unverified|gate)  echo "JS jvm rust Swift";;
    show|where|callers|map|containment|diff|reachable|impact|blindspots|whatif) echo "JS jvm rust";;
    parsepolicy)       echo "JS jvm rust Swift";;
    rewire)            echo "jvm rust";;
    agents)            echo "JS rust";;
    privacy-manifest)  echo "Swift";;
    *)                 echo "";;
  esac
}
# backend token → the CANONICAL ARM. Rust owns the OPEN REMAINDER of backend tokens — `scan`, plus the
# nightly-lint crate types (`lib`, `Executable`, `Rlib`, `Dylib`, `bin`, …) — so a raw token comparison
# refuses `candor show` on a Rust report whose token is `scan`. That is exactly what the first version of
# the capability check did, and it turned a routing fix into a routing regression. The dispatch below
# already encodes this rule (three fixed tokens, everything else rust); this names it so both agree.
backend_arm() {
  case "$1" in JS) echo "JS";; jvm) echo "jvm";; Swift) echo "Swift";; *) echo "rust";; esac
}
# canonical arm → the engine a human installs, for an error message that names a remedy.
engine_name() {
  case "$(backend_arm "$1")" in JS) echo "candor-ts";; jvm) echo "candor-java";; Swift) echo "candor-swift";; *) echo "candor-rust";; esac
}

# FETCH AN ENGINE ON FIRST USE, so `brew install candor` is followed by a QUESTION, not by errands.
# The umbrella's whole job is to put the right engine in front of you; telling you to go and run
# `candor update` first is that job, described rather than done. Only ever fetches the PINNED version
# from the same package registries `candor update` uses (github.com · crates.io · npm) — no candor
# server, no telemetry — and says so before it does it, because a tool that reaches the network without
# saying so has spent trust it cannot get back. CANDOR_NO_AUTOFETCH=1 turns it off.
autofetch_engine() {
  local lang="$1"
  [ -z "${CANDOR_NO_AUTOFETCH:-}" ] || return 1
  [ -z "${CANDOR_DISPATCH_DRYRUN:-}" ] || return 1
  case "$lang" in
    swift) [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || return 1;;
    rust|java|ts) ;;
    *) return 1;;
  esac
  echo "candor: the $lang engine isn't installed — fetching v$ENGINE_PIN from the package registry (no candor server, no telemetry)." >&2
  # Re-invoke this same script's `update`, which is an inline case branch ending in `exit` rather than a
  # function — a subshell is the honest way to reuse it without refactoring the release-critical path.
  ( "$0" update "$lang" >&2 ) || true
  engine_present "$lang"
}

# is the engine for <lang> resolvable right now? (mirrors engine_scan's resolution)
engine_present() {
  case "$1" in
    rust)  rust_bin candor-scan >/dev/null 2>&1;;
    ts)    have candor-ts || have node;;   # node ⇒ npx can run it
    java)  have candor-java || [ -x "$CDBIN/candor-java" ] || [ -n "${CANDOR_JAVA_JAR:-}" ] || ls "$HOME"/.candor/candor-java*-all.jar >/dev/null 2>&1;;
    swift) rust_bin candor-swift >/dev/null 2>&1;;
    *) return 1;;
  esac
}
# auto-fetch a missing engine (used by init — a setup command, so a fetch is expected; scan never does this).
ensure_engine() {
  engine_present "$1" && return 0
  echo "  · the $1 engine isn't installed — fetching it (candor update $1)…"
  "$0" update "$1" >/dev/null 2>&1 || true
  engine_present "$1"
}
# scan ONE named language in a dir, bypassing the mixed-repo guard (used by init per language). Carries
# the consistent missing-engine errors — all point at `candor update <engine>`.
engine_scan() {
  local lang="$1"; shift
  case "$lang" in
    rust) local c; c=$(rust_bin candor-scan) || { autofetch_engine rust && c=$(rust_bin candor-scan); }; [ -n "$c" ] || die "a Rust project, but the rust engine isn't installed and could not be fetched — run \`candor update rust\`."; run "$c" "$@";;
    ts)    if have candor-ts; then run candor-ts "$@"; elif have node; then run npx -y "candor-ts@$ENGINE_PIN" "$@"; else die "a TypeScript project, but Node isn't installed (the ts engine runs via npx) — install Node."; fi;;
    java)
      # --workspace/--deps is N/A for the bytecode engine — it is given the whole classpath, so cross-module
      # interface dispatch resolves natively (no per-package chaining). The JVM CLI errors on the unknown flag,
      # so strip it here with a note (the source engines rust/ts/swift forward it unchanged via "$@").
      case " $* " in
        *" --workspace "*|*" --deps "*)
          echo "candor: --workspace is N/A for the JVM engine — whole-classpath bytecode resolves cross-module dispatch natively; ignoring it." >&2
          local ja=() a3; for a3 in "$@"; do case "$a3" in --workspace|--deps) ;; *) ja+=("$a3");; esac; done
          set -- "${ja[@]}";;
      esac
      # the JVM engine's bare run prints the table but persists nothing (its --json writes the report).
      # Every other engine persists by default, and the whole query flow (tour/where/path) reads the
      # persisted report — so when no output flag is given, write the report where discovery looks.
      case " $* " in
        *" --json "*|*" --gate-json "*) run_java "$@";;
        *)
          local jt="." a2
          for a2 in "$@"; do case "$a2" in -*) ;; *) jt="$a2"; break;; esac; done
          # persist only if we can create .candor/ (a read-only checkout, e.g. CI, falls back to a bare
          # run — print the table, don't try to --json to an unwritable path and fail the engine).
          if [ -d "$jt" ] && mkdir -p "$jt/.candor" 2>/dev/null; then run_java "$@" --json "$jt/.candor/report.json"
          else run_java "$@"; fi;;
      esac;;
    swift) local c; c=$(rust_bin candor-swift) || { autofetch_engine swift && c=$(rust_bin candor-swift); }; [ -n "$c" ] || die "a Swift project, but the swift engine isn't installed and could not be fetched — run \`candor update swift\`."; run "$c" "$@";;
    *) die "no engine for '$lang'.";;
  esac
}
route_scan() {
  # First POSITIONAL is the scan target — skipping flags AND the VALUES of value-taking flags, so
  # `candor scan --gate-json verdict.json` (target omitted, defaulting to `.`) does NOT mistake the
  # gate-json OUTPUT path for the target and then fail the -e guard on it (review finding). Mirrors
  # nth_positional's flag-value skip.
  local a target="." skip=0
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in --report|--policy|--gate-json) skip=1;; -*) ;; *) target="$a"; break;; esac
  done
  # A path that doesn't exist is a "no such directory" error naming the FULL path — not a truncated,
  # manifest-blaming message. Before this, `candor scan /does/not/exist` ran dirname (dropping `exist`) and
  # reported "can't tell what language /does/not is (no Cargo.toml …)", conflating absent with manifest-less
  # (#24). `.` and real files/dirs pass through unchanged.
  [ -e "$target" ] || die "no such file or directory: $target"
  local dir; if [ -d "$target" ]; then dir="$target"; else dir="$(dirname "$target")"; fi
  local langs n; langs="$(detect_langs "$dir")"; n=$(set -- $langs; echo $#)
  [ "$n" -ge 1 ] || die "can't tell what language $dir is (no Cargo.toml / package.json / build.gradle / Package.swift). Run the engine directly: candor-scan | candor-ts | candor-java | candor-swift."
  [ "$n" -eq 1 ] || die "$dir mixes languages ($langs) — scan one at a time (\`candor scan <subdir>\`), or \`candor init\` to set up every language at once."
  engine_scan "$langs" "$@"
}

# Per-action usage (F9: `candor <verb> --help` used to reach the engine, which read --help as an effect/fn
# name). One line per query verb; policy-consuming verbs also name the deny/pure/allow/forbid grammar.
# THE ARM THIS DIRECTORY'S PROJECT WOULD USE, or empty when it cannot be told without guessing.
#
# Prefers a report that actually exists (the same backend token `route_query` dispatches on), and falls
# back to the project MANIFEST when there is no report yet — a `--help` before the first scan is the most
# likely moment to ask. Returns EMPTY on a mixed or unrecognised tree rather than picking one: a capability
# note attached to the wrong arm would be worse than no note, and this whole feature exists because a
# WRONG-LOOKING answer is worse than a missing one.
context_arm() {
  local d="$PWD" base=""
  while :; do [ -d "$d/.candor" ] && { base="$d/.candor/report"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
  if [ -n "$base" ]; then
    local f b uniq="" n=0
    for f in "$base".*.json "$base.json"; do
      [ -e "$f" ] || continue
      is_sidecar "$f" && continue
      b="${f%.json}"
      case "$(basename "$b")" in *.*) b="${b##*.}";; *) b="$(sniff_backend "$f")";; esac
      case " $uniq " in *" $(backend_arm "$b") "*) ;; *) uniq="$uniq $(backend_arm "$b")"; n=$((n+1));; esac
    done
    [ "$n" = 1 ] && { echo "${uniq# }"; return; }
    [ "$n" -gt 1 ] && return          # several engines here — do not pick one
  fi
  # no report: fall back to the manifest, but only when it names exactly ONE language.
  local langs; langs="$(detect_langs "$PWD")"
  case "$langs" in
    rust)  echo "rust";;  ts) echo "JS";;  java) echo "jvm";;  swift) echo "Swift";;
    *) ;;                                # none, or a mixed tree
  esac
}

# Self-test hook (bin/candor.test.sh): print the resolved arm and exit. The capability note is only as good
# as context_arm, and asserting on the note alone cannot tell "correctly silent" from "silent for an
# unrelated reason" — the /tmp assertion passed that way until it was probed.
[ "${CANDOR_SELFTEST:-}" = "arm" ] && { context_arm; exit 0; }


verb_help() {
  case "$1" in
    where)    echo "candor where <Effect> — the functions that perform an effect, directly or transitively.";;
    path)     echo "candor path <fn> <Effect> — the call path by which <fn> reaches <Effect> (an annotated call tree).";;
    callers)  echo "candor callers <fn> — who calls <fn>, directly and transitively.";;
    tour)     echo "candor tour [N] — the N most surprising transitive reaches (default 10).";;
    blindspots) echo "candor blindspots — the Unknown sources worth resolving, ranked by reach.";;
    gains)    echo "candor gains <current> <base> — what a newer report newly reaches vs a baseline (the supply-chain diff)."; echo "  Advisory (exit 0). --strict → exit 1 on ANY gained effect (a supply-chain CI gate).";;
    show)     echo "candor show <fn> — the full effect record for one function.";;
    map)      echo "candor map — the module/layer effect map.";;
    containment) echo "candor containment — effects grouped by the layer that contains them.";;
    diff)     echo "candor diff <a> <b> — the effect delta between two reports.";;
    reachable) echo "candor reachable <fn> — everything <fn> can reach.";;
    impact)   echo "candor impact <fn> — who is affected if <fn> changes.";;
    rewire)   echo "candor rewire — suggested edges to cut a boundary crossing.";;
    agents)   echo "candor agents — the declared-vs-observed effect drift (agent-fleet report).";;
    fix)      echo "candor fix <fn> <Effect> — the boundary hoist that would clear a violation."; echo "  Reads the wired policy (.candor/config) or --policy <file>.";;
    fix-gate) echo "candor fix-gate — every policy crossing in the report and its remedy."; echo "  Reads the wired policy (.candor/config) or --policy <file>. Advisory (exit 0); --strict → exit 1 while a crossing remains.";;
    whatif)   echo "candor whatif <fn> <Effect> — the blast radius (and policy verdict) IF <fn> gained <Effect>, before you edit."; echo "  Reads the wired policy (.candor/config) or --policy <file>.";;
    unverified) echo "candor unverified — the layers a policy gates that still contain Unknown holes (coverage proof).";;
    gate)     echo "candor gate --report <locator> --policy <file> — apply a policy to an EXISTING report, no scan."
              echo "  the supply-chain gate: exit 0 clean · 1 violation · 2 unevaluable (never a silent pass).";;
    privacy-manifest)
              echo "candor privacy-manifest [--verify <Info.plist>] — the Apple usage-description keys the code's"
              echo "  sensor reach requires. Bare: GENERATE them. --verify: check a plist, exit 1 on an"
              echo "  under-declaration, 2 on an unreadable manifest. candor-swift only (the privacy/2 extension).";;
    parsepolicy) echo "candor parsepolicy <file> — echo the parsed policy AST (deny / pure / allow / forbid rules)."; echo "  Grammar: \`deny <Effect> <layer>\` · \`pure <layer>\` · \`allow <Effect> <layer>\` · \`forbid <Effect> <layer>\`.";;
    *)        echo "candor $1 — see \`candor --help\`.";;
  esac
  echo ""
  echo "Effects: $EFFECTS   ·   \`candor effects\` explains each."
  echo "Options: --report <locator>   --policy <file>   --json   (uniform across every engine)."
}

verb="${1:-}"
# opt-in, cache-only (no network here) — a one-line "newer version available" nudge, silent by default.
show_update_notice
case "$QUERY_VERBS" in
  *" $verb "*)
    case " $* " in *" --help "*|*" -h "*)
      verb_help "$verb"
      # ⟨capability⟩ Help that describes a verb this project's engine does NOT implement is a dead end
      # dressed as documentation: the reader follows it and gets a refusal. Say so here, and name the
      # engines that do. Silent when the arm cannot be told without guessing — a note on the wrong arm
      # would be worse than none.
      _arm="$(context_arm)"; _sup="$(verb_engines "$verb")"
      if [ -n "$_arm" ] && [ -n "$_sup" ]; then
        case " $_sup " in
          *" $_arm "*) ;;
          *) _names=""; for _t in $_sup; do _names="$_names, $(engine_name "$_t")"; done
             echo
             echo "NOT AVAILABLE HERE: $(engine_name "$_arm") does not implement \`$verb\`."
             echo "  the engine(s) that do: ${_names#, }";;
        esac
      fi
      exit 0;; esac
    route_query "$@"; exit $?;;
esac
case "$verb" in
  verify)
    # `candor verify [<dir>] --run "<cmd>" [--scope] [--json]` — the DYNAMIC HONESTY ORACLE: run a program
    # under a runtime capture and check candor's static claim against reality (observed ⊆ inferred ∪ Unknown
    # per executed fn). A cardinal-sin escape exits 1. The capture is runtime-specific: the Node arm wraps
    # the Node effect boundary (ts engine), the JVM arm instruments bytecode via a -javaagent (java engine).
    # We route by the target's language so `candor verify` matches whatever you scanned; `--engine node|java`
    # forces it (for a mixed repo, or to check a jar the language sniff can't classify).
    shift
    # Pass 1: read --engine (explicit override) + the first positional (the target dir), skipping the values
    # of value-taking flags. Rebuild the arg list WITHOUT --engine (neither engine's verify knows that flag).
    veng=""; vdir="."; vskip=0; vnext=0; vargs=()
    for a2 in "$@"; do
      if [ "$vskip" = 1 ]; then vskip=0; vargs+=("$a2"); continue; fi
      if [ "$vnext" = 1 ]; then vnext=0; veng="$a2"; continue; fi   # value of --engine, dropped
      case "$a2" in
        --engine) vnext=1;;
        --run|--report|--scope|--syscall-trace|--trace-format) vskip=1; vargs+=("$a2");;
        -*) vargs+=("$a2");;
        *) [ "$vdir" = "." ] && vdir="$a2"; vargs+=("$a2");;
      esac
    done
    if [ "$veng" != "node" ] && [ "$veng" != "java" ]; then
      # auto-detect the arm from the target, using only UNAMBIGUOUS signals: a *.jar target, or a JVM source
      # project (build.gradle/pom.xml/*.java) the manifest sniff classifies as java. Everything else — a ts
      # project, a mixed repo, a bare classdir, an unknown dir — takes the Node arm. (A stray *.class deep in
      # a repo is NOT a signal: it misroutes ts projects that vendor bytecode.) For a bare classdir the sniff
      # can't see, pass `--engine java` explicitly — that's the escape hatch.
      veng="node"
      if [ -d "$vdir" ]; then vd="$vdir"; else vd="$(dirname "$vdir")"; fi
      case "$vdir" in *.jar) veng="java";; esac
      if [ "$veng" = "node" ] && [ "$(detect_langs "$vd" 2>/dev/null)" = "java" ]; then veng="java"; fi
      # A RUST- or SWIFT-ONLY TARGET HAS NO ORACLE ARM, AND MUST SAY SO RATHER THAN TAKE THE NODE ONE.
      # `verify` ships two arms (node, java). The fallthrough above sent everything else to node, so a
      # Swift package was verified by the TypeScript oracle — which then advised "scan the project first
      # (candor-ts <dir>)", i.e. a remedy naming the wrong engine for the user's language. A wrong remedy
      # is worse than no remedy: it costs the user a run to find out. (Both languages DO have dynamic
      # oracles — candor-rust's strace `realworld-oracle` CI lane and candor-swift's recall/strace lanes —
      # they are harnesses in those repos, not a user-facing verb, which is the real gap this names.)
      # Only when the target is UNAMBIGUOUSLY one of them: a mixed repo that also has package.json or a
      # JVM manifest keeps the old behaviour, because there the node/java arm may genuinely be the point.
      if [ "$veng" = "node" ]; then
        vlangs="$(detect_langs "$vd" 2>/dev/null)"
        case "$vlangs" in
          rust|swift|"rust swift")
            echo "candor verify: no oracle arm for ${vlangs} yet — \`verify\` ships the node and java arms." >&2
            echo "  This target looks like ${vlangs}, and running the node arm over it would check a claim" >&2
            echo "  candor-ts never made. What you can do instead:" >&2
            echo "    · the static gate:      candor scan $vdir --policy <file>" >&2
            echo "    · force an arm anyway:  candor verify $vdir --engine node|java   (if this is a mixed repo)" >&2
            echo "  The dynamic oracle DOES cover ${vlangs} as a CI lane in that engine's own repo" >&2
            echo "  (candor-rust realworld-oracle / candor-swift recall+strace); it is not yet a verb here." >&2
            exit 2;;
        esac
      fi
    fi
    if [ "$veng" = "java" ]; then
      run_java verify "${vargs[@]}"
    elif have candor-ts-verify; then run candor-ts-verify "${vargs[@]}"
    elif have node; then run npx -y -p "candor-ts@$ENGINE_PIN" candor-ts-verify "${vargs[@]}"
    else die "candor verify needs Node (the honesty oracle wraps the Node runtime; the ts engine runs via npx) — install Node."; fi
    ;;
  effects|glossary)
    # The core noun, explained. The persona audit found nothing a user naturally runs ever says what an
    # "effect" IS or lists the names — novices finished a session fuzzy on the headline concept.
    cat <<'H'
An effect is something your code does to the outside world — reach the network, read a
file, spawn a process. candor tracks which functions perform each one, directly or through
everything they transitively call. `candor where <Effect>` lists them; `candor path <fn> <Effect>`
shows the route.

  Net        network I/O — HTTP, sockets, DNS
  Fs         the filesystem — read, write, list, stat files
  Db         a database or datastore
  Llm        a model-provider / LLM API call
  Exec       runs another process or a shell command
  Env        reads or writes environment variables
  Clock      reads the wall clock — time, date, timers
  Ipc        talks to other processes — pipes, signals, local sockets
  Log        writes logs / diagnostic output
  Rand       draws randomness / entropy
  Clipboard  reads or writes the system clipboard
  Unknown    a call candor could NOT resolve to a known effect — the §4 trust marker,
             not "no effect". `candor blindspots` ranks the ones worth resolving.

Names are capitalised. Try:  candor where Net   ·   candor tour   ·   candor blindspots
H
    exit 0;;
  config)
    # tiny global settings store (~/.candor/settings). Currently one key: update-check on|off (default off).
    shift || true; key="${1:-}"; val="${2:-}"
    case "$key" in
      ""|list) echo "update-check=$([ "$(setting update-check)" = on ] && echo on || echo off)   # opt-in daily check for newer engine versions (off by default; the check only runs on update/outdated/doctor and is cached)"; exit 0;;
      update-check)
        case "$val" in
          on|off) mkdir -p "$(dirname "$SETTINGS")"; touch "$SETTINGS"
            tmp=$(mktemp); grep -v "^update-check=" "$SETTINGS" 2>/dev/null > "$tmp" || true; echo "update-check=$val" >> "$tmp"; mv "$tmp" "$SETTINGS"
            [ "$val" = on ] && echo "update-check on — candor will check for newer versions at most once/day (only when you run update/outdated/doctor) and show a one-line notice. No code or reports are ever sent; it queries the public package registries only. Turn off: candor config update-check off"
            [ "$val" = off ] && echo "update-check off — no automatic version checks. (candor outdated still checks on demand.)"
            exit 0;;
          *) die "usage: candor config update-check on|off";;
        esac;;
      *) die "unknown config key '$key' (known: update-check). \`candor config\` to list.";;
    esac;;
  "")
    # bare `candor` inside an analyzed repo = a STATUS dashboard (git-style); outside one, help.
    d="$PWD" croot=""
    while :; do [ -d "$d/.candor" ] && { croot="$d"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
    if [ -n "$croot" ] && ls "$croot"/.candor/report*.json >/dev/null 2>&1; then
      python3 - "$croot" <<'PY'
import json, glob, os, sys, time
root = sys.argv[1]; cd = os.path.join(root, ".candor")
reps = [p for p in glob.glob(cd + "/report*.json")
        if not any(s in p for s in (".callgraph.", ".hierarchy.", ".calibrated.", ".gate.", ".encountered-"))]
print(f"candor status — {os.path.basename(root)}")
cfg = os.path.join(cd, "config")
keys = {}
if os.path.exists(cfg):
    for line in open(cfg):
        line = line.strip()
        if line and not line.startswith("#") and " " in line:
            k, v = line.split(None, 1); keys[k] = v
        elif line and not line.startswith("#"):
            keys[line] = True
for p in sorted(reps):
    # ONE guard around the whole per-report body — a report can be valid JSON of the wrong SHAPE
    # (functions not a list of dicts, candor/coverage a string) and every access below must degrade
    # to "unreadable", never spill a traceback into the dashboard.
    try:
        r = json.load(open(p))
        env = r.get("candor") or r.get("meta") or {}
        if not isinstance(env, dict): env = {}
        fns = r.get("functions", [])
        if not isinstance(fns, list): fns = []
        tally = {}
        for f in fns:
            if not isinstance(f, dict): continue
            for e in f.get("inferred", []) or []: tally[e] = tally.get(e, 0) + 1
        age = time.time() - os.path.getmtime(p)
        ages = f"{int(age/60)}m ago" if age < 3600 else (f"{int(age/3600)}h ago" if age < 172800 else f"{int(age/86400)}d ago")
        ts = ", ".join(f"{k} {v}" for k, v in sorted(tally.items(), key=lambda kv: -kv[1])[:6]) or "no effects"
        cov = (r.get("coverage") if isinstance(r.get("coverage"), dict) else {}).get("uncovered", []) or []
        covs = f" · {len(cov)} uncovered dep(s)" if cov else ""
        print(f"  report   {os.path.basename(p)} — {len(fns)} effectful fns ({ts}){covs}")
        print(f"  scanned  {ages} (engine {env.get('version','?')}, spec {env.get('spec','?')})")
    except Exception:
        print(f"  {os.path.basename(p)}: unreadable")
print(f"  policy   {'wired: ' + str(keys.get('policy')) if keys.get('policy') else 'none — `candor init` proposes one'}")
print(f"  baseline {'wired: ' + str(keys.get('baseline')) if keys.get('baseline') else ('per-engine files present' if glob.glob(cd + '/baseline*.json') else 'none — the regression ratchet is off')}")
PY
      # freshness marker (reuse the same pruned single-hit probe)
      repfile="$(ls -t "$croot"/.candor/report*.json 2>/dev/null | grep -vE 'callgraph|hierarchy|calibrated|gate|encountered' | head -1)"
      newer=$(find "$croot" \( -name .git -o -name .candor -o -name node_modules -o -name target -o -name build -o -name .build -o -name dist \) -prune -o \
        -type f \( -name '*.rs' -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' -o -name '*.java' -o -name '*.kt' -o -name '*.scala' -o -name '*.swift' \) \
        -newer "$repfile" -print -quit 2>/dev/null)
      [ -n "$newer" ] && echo "  ⚠ stale  source changed since the scan (${newer#"$croot"/}) — re-run \`candor scan .\`"
      echo ""
      # Context-aware next step: candor's value is the GATE. If none is set up yet (no policy key AND no
      # baseline), lead the user there; once gated, point at the query + CI commands.
      cfg="$croot/.candor/config"
      has_gate=no
      { grep -qs "^policy" "$cfg" || grep -qs "^baseline" "$cfg" || ls "$croot"/.candor/baseline*.json >/dev/null 2>&1; } && has_gate=yes
      if [ "$has_gate" = no ]; then
        echo "  Next → turn this map into a gate:  candor init"
        echo "         (proposes an architecture policy from what your code already does + a regression ratchet)"
        echo "  Explore → candor tour · candor where <Effect> · candor path <fn> <Effect>"
      else
        echo "  candor tour · candor where <Effect> · candor path <fn> <Effect>"
        # `candor scan .` REFUSES a polyglot dir ("scan one at a time"), so don't hand a polyglot user a
        # command the scanner rejects — name the per-language gate (as `candor init` did) instead (re-audit).
        dlangs="$(detect_langs "$croot")"; dn=$(set -- $dlangs; echo $#)
        if [ "${dn:-0}" -gt 1 ]; then
          echo "  gate it in CI (one per language — \`candor scan .\` refuses a mixed dir; run each engine):"
          for dl in $dlangs; do
            deng=candor-scan; case "$dl" in ts) deng="npx -y candor-ts";; java) deng=candor-java;; swift) deng=candor-swift;; esac
            echo "    $deng . --gate-json verdict.json   ($dl — exit 1 on a violation)"
          done
        else
          echo "  gate it in CI → candor scan . --gate-json verdict.json  (exit 1 on a violation)"
        fi
      fi
      exit 0
    fi
    exec "$0" --help;;
  -h|--help)
    cat <<'H'
candor — the effect analyzer. One command across every language.

New here?  Run  candor scan .  in a project — it finds the most surprising thing your
code reaches and hands you the next command. (`candor effects` explains what an "effect" is.)

Each invocation routes to the matching engine: a scan by the
project's manifest, a query by the discovered report's backend. Every engine speaks
the same grammar, so verbs and flags pass straight through — and an ambiguous
target is a loud error, never a silent guess. No candor server, no telemetry.

USAGE
  candor                               in an analyzed repo: a status dashboard (else this help)
  candor scan <dir>                    analyse a project (engine picked by its manifest)
  candor effects                       what the effect names (Net, Fs, Db, …) mean
  candor init [<dir>]                  stand up the gate: scan, policy, baseline, and a CI workflow
  candor hook [install] [<dir>]        wire the end-of-turn gate into your coding agent (Claude Code)
  candor mcp · candor lsp              run the MCP server / language server (for agents & editors)
  candor <action> [args] [options]     query the discovered report (.candor/, walk-up)
  candor engines                       list the engines, where each comes from, and its status
  candor update [engine...]            fetch / refresh engines (JVM native binary, no JVM needed)
  candor outdated                      check the release channels for newer engine versions
  candor doctor                        check every engine is installed and compatible
  candor config update-check on        opt in to a once/day newer-version notice (off by default)

COMMON ACTIONS  (add --help to any for its own usage)
  where <Effect>            the functions that perform an effect
  path <fn> <Effect>        the call path by which a function reaches an effect
  callers <fn>              who calls a function, direct and transitive
  tour [N]                  the N most surprising transitive reaches (default 10)
  blindspots                the Unknown sources worth resolving, ranked by reach
  gains <current> <base>    what a new version newly reaches (the supply-chain diff)
  fix <fn> <Effect>         the boundary hoist that would clear a violation

ALL ACTIONS
  show  where  callers  map  containment  diff  reachable  impact  blindspots
  gains  path  tour  whatif  fix  fix-gate  unverified  rewire  parsepolicy  agents

OPTIONS  (uniform across every engine)
  --report <locator>        use this report instead of discovering .candor/
  --policy <file>           evaluate a policy — exit 1 on a violation
  --json                    machine-readable output
  -V, --version             version of the umbrella + every installed engine
  -h, --help                show this help

EXAMPLES
  candor scan .
  candor where Db
  candor path OrderService.render Net
  candor gains lib-2.0.jar lib-1.9.jar

ENGINES
  rust    candor-scan / candor-query    cargo install, or candor-rust/install.sh
  jvm     the candor-java jar           ~/.candor/*.jar, or CANDOR_JAVA_JAR
  ts      candor-ts                     runs via npx when not installed
  swift   candor-swift                  build from the candor-swift repo

Docs: candor.poly.io   ·   Verify an install: candor doctor
H
    exit 0;;
  -V|--version)
    # version details for every locally-installed engine, one aligned table (fast paths
    # only — no npx; `candor doctor` does the full check incl. the npx fallback). Exit 0.
    { echo "candor $UMBRELLA_VERSION (umbrella)"
      rb="$(rust_bin candor-scan 2>/dev/null)" && "$rb" --version 2>/dev/null | head -1
      rb="$(rust_bin candor-query 2>/dev/null)" && "$rb" --version 2>/dev/null | head -1
      if have candor-java; then candor-java --version 2>/dev/null | head -1
      elif [ -x "$CDBIN/candor-java" ]; then "$CDBIN/candor-java" --version 2>/dev/null | head -1
      else jar="${CANDOR_JAVA_JAR:-$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)}"
           { [ -n "$jar" ] && [ -f "$jar" ]; } && java -jar "$jar" --version 2>/dev/null | head -1; fi
      have candor-ts && candor-ts --version 2>/dev/null | head -1
      swb="$(rust_bin candor-swift 2>/dev/null)" && "$swb" --version 2>/dev/null | head -1
    } | awk '{ rest=""; for (i=3;i<=NF;i++) rest=rest (i>3?" ":"") $i; printf "%-14s %-8s %s\n", $1, $2, rest }'
    echo ""
    echo "check for a newer version:  candor outdated"
    echo "update the whole family:    brew upgrade candor && candor update"
    exit 0;;
  outdated|check)
    # Ask each engine's release channel whether a newer version exists. EXPLICIT network (user-invoked,
    # never a silent beacon) — same provenance as `update`. Classifies per engine: up to date / a POINT
    # update within your spec line (safe — same spec, `candor update` fetches it) / a NEW spec line (a
    # minor bump — adopt it by upgrading the umbrella so the whole family moves together).
    have curl || die "outdated needs curl on PATH."
    echo "candor: querying release channels (github.com · crates.io · npm) — explicit check, no telemetry."
    echo ""
    printf "  %-7s %-12s %-12s %s\n" "ENGINE" "INSTALLED" "LATEST" "STATUS"
    # installed versions (build number = field 2 of the --version line)
    ivjvm=""; if have candor-java; then ivjvm=$(candor-java --version 2>/dev/null | head -1 | awk '{print $2}')
      elif [ -x "$CDBIN/candor-java" ]; then ivjvm=$("$CDBIN/candor-java" --version 2>/dev/null | head -1 | awk '{print $2}'); fi
    ivrust=""; rb="$(rust_bin candor-scan 2>/dev/null)" && ivrust=$("$rb" --version 2>/dev/null | head -1 | awk '{print $2}')
    ivts=""; tsnpx=""; if have candor-ts; then ivts=$(candor-ts --version 2>/dev/null | head -1 | awk '{print $2}'); elif have node; then tsnpx=1; fi
    ivsw=""; swb="$(rust_bin candor-swift 2>/dev/null)" && ivsw=$("$swb" --version 2>/dev/null | head -1 | awk '{print $2}')
    # latest from each channel (best-effort; a channel we can't reach says so, never a false "up to date")
    ljvm=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-java/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lrust=$(curl -fsSL -H "User-Agent: candor-cli" "https://crates.io/api/v1/crates/candor-scan" 2>/dev/null | sed -n 's/.*"max_stable_version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lts=$(curl -fsSL "https://registry.npmjs.org/candor-ts/latest" 2>/dev/null | sed -n 's/.*"version":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
    lsw=$(curl -fsSL "https://api.github.com/repos/tombaldwin/candor-swift/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
    # refresh the nudge cache from this explicit check (so an opted-in notice reflects the latest)
    { echo "checked=$(date +%s 2>/dev/null || echo 0)"; echo "jvm=$ljvm"; echo "rust=$lrust"; echo "ts=$lts"; } > "$UPDATE_CACHE" 2>/dev/null || true
    # classify: same → up to date; same major.minor, higher patch → point update; higher minor → new spec line
    classify() { python3 - "$1" "$2" <<'PY'
import sys
inst, lat = sys.argv[1], sys.argv[2]
if not inst: print("not installed"); raise SystemExit
if not lat:  print("? channel unreachable"); raise SystemExit
def t(v): return tuple(int(x) for x in (v.split(".")+["0","0","0"])[:3])
i, l = t(inst), t(lat)
if l <= i: print("up to date")
elif l[:2] == i[:2]: print(f"point update {lat} available — same spec; `candor update`")
else: print(f"NEW spec line {lat} — `brew upgrade candor` to move the family")
PY
    }
    printf "  %-7s %-12s %-12s %s\n" "jvm"   "${ivjvm:--}"  "${ljvm:--}"  "$(classify "$ivjvm" "$ljvm")"
    printf "  %-7s %-12s %-12s %s\n" "rust"  "${ivrust:--}" "${lrust:--}" "$(classify "$ivrust" "$lrust")"
    if [ -n "$tsnpx" ]; then printf "  %-7s %-12s %-12s %s\n" "ts" "via npx" "${lts:--}" "always latest on run (npx)"
    else printf "  %-7s %-12s %-12s %s\n" "ts" "${ivts:--}" "${lts:--}" "$(classify "$ivts" "$lts")"; fi
    printf "  %-7s %-12s %-12s %s\n" "swift" "${ivsw:--}"   "${lsw:--}"   "$(classify "$ivsw" "$lsw")"
    echo ""
    echo "  A point update keeps your spec line (safe). A new spec line moves the whole family — take it"
    echo "  by upgrading the umbrella, so every engine stays in agreement (candor doctor verifies)."
    exit 0;;
  engines)
    # List the engines the umbrella manages: what each is, where it comes from, and its status.
    # A pure read — checks what's installed locally; makes NO network calls (unlike `update`).
    echo "candor engines — engines pinned to $ENGINE_PIN (umbrella $UMBRELLA_VERSION)"
    echo ""
    printf "  %-7s %-30s %s\n" "ENGINE" "STATUS" "SOURCE"
    jstat="not installed — run \`candor update\`"
    if have candor-java; then jstat="installed $(candor-java --version 2>/dev/null | head -1 | awk '{print $2}') (PATH)"
    elif [ -x "$CDBIN/candor-java" ]; then jstat="installed $("$CDBIN/candor-java" --version 2>/dev/null | head -1 | awk '{print $2}') (native)"
    elif ls "$HOME"/.candor/candor-java*-all.jar >/dev/null 2>&1; then jstat="installed (jar — needs a JVM)"; fi
    printf "  %-7s %-30s %s\n" "jvm" "$jstat" "github release — native binary (flagship)"
    rstat="not installed"; rb="$(rust_bin candor-scan 2>/dev/null)" && rstat="installed $("$rb" --version 2>/dev/null | head -1 | awk '{print $2}')"
    printf "  %-7s %-30s %s\n" "rust" "$rstat" "crates.io — cargo install (needs rust)"
    tstat="not installed"; if have candor-ts; then tstat="installed (global)"; elif have node; then tstat="available via npx (no install)"; else tstat="needs Node"; fi
    printf "  %-7s %-30s %s\n" "ts" "$tstat" "npm — runs via npx"
    sstat="not installed (optional)"; swb="$(rust_bin candor-swift 2>/dev/null)" && sstat="installed $("$swb" --version 2>/dev/null | head -1 | awk '{print $2}')"
    printf "  %-7s %-30s %s\n" "swift" "$sstat" "source build (macOS + swift)"
    echo ""
    echo "  candor update [jvm|rust|ts|swift ...]   fetch/refresh (all if none named)"
    echo "  candor doctor                           verify installs + spec agreement"
    exit 0;;
  install|update|upgrade)
    # Fetch/refresh the engines the umbrella manages, pinned to ENGINE_PIN so the whole family
    # moves together (spec agreement guaranteed). The flagship JVM engine ships a native binary — no
    # JVM needed — which is what most people want; ts runs via npx with no install; rust/swift need a
    # toolchain and are set up only when one is present (else a note, never a hard failure).
    # Optional args select engines: `candor update jvm rust` (default: all).
    shift || true
    # want <engine>: true if the user named it (or named none → all). Gate on REQ, not $# ($# is want's
    # own arg count, always 1). Accept the language token `java` as a synonym for the `jvm` engine.
    REQ="$*"; REQ="${REQ//java/jvm}"
    want() { [ -z "$REQ" ] && return 0; case " $REQ " in *" $1 "*) return 0;; *) return 1;; esac; }
    if [ -n "${CANDOR_UPDATE_DRYRUN:-}" ]; then   # test hook: print the resolved engine set, no network
      sel=""; for e in jvm rust ts swift; do want "$e" && sel="$sel $e"; done; echo "${sel# }"; exit 0
    fi
    have curl || die "install needs curl on PATH."
    mkdir -p "$CDBIN"
    # Provenance, stated up front — `update` is the ONE network action; the analysis itself never is.
    echo "candor: fetching from package registries only (github.com · crates.io · npm) — no candor server, no telemetry, no version-check ping."
    tag="v$ENGINE_PIN"
    base="https://github.com/tombaldwin/candor-java/releases/download/$tag"
    # the native asset for this platform (GraalVM binaries: macos-arm64, linux-x64), else fall to the jar
    os=$(uname -s); arch=$(uname -m); asset=""
    case "$os:$arch" in
      Darwin:arm64)          asset="candor-macos-arm64" ;;
      Linux:x86_64|Linux:amd64) asset="candor-linux-x64" ;;
    esac
    echo "candor: syncing engines to $ENGINE_PIN (the pinned engine line)"
    # --- JVM engine (flagship) ---
    if want jvm; then
    if [ -n "$asset" ]; then
      echo "  jvm    → native binary ($asset), no JVM required"
      if curl -fsSL -o "$CDBIN/candor-java.tmp" "$base/$asset"; then
        chmod +x "$CDBIN/candor-java.tmp" && mv "$CDBIN/candor-java.tmp" "$CDBIN/candor-java"
        echo "         ✔ $("$CDBIN/candor-java" --version 2>/dev/null | head -1)"
      else
        rm -f "$CDBIN/candor-java.tmp"; echo "         ✘ download failed ($base/$asset)"
      fi
    else
      echo "  jvm    → no native binary for $os/$arch; fetching the jar (needs a JVM at runtime)"
      if curl -fsSL -o "$HOME/.candor/candor-java-$ENGINE_PIN-all.jar.tmp" "$base/candor-java-$ENGINE_PIN-all.jar"; then
        mv "$HOME/.candor/candor-java-$ENGINE_PIN-all.jar.tmp" "$HOME/.candor/candor-java-$ENGINE_PIN-all.jar"
        echo "         ✔ jar stashed in ~/.candor/"
      else
        rm -f "$HOME/.candor/candor-java-$ENGINE_PIN-all.jar.tmp"; echo "         ✘ jar download failed"
      fi
    fi
    fi
    # --- TypeScript engine: zero-install via npx ---
    if want ts; then
      if have node; then echo "  ts     → runs via npx on demand (no install needed)"
      else echo "  ts     → install Node to enable the TypeScript engine (then it runs via npx)"; fi
    fi
    # --- Rust engine: needs a toolchain; set up only when present ---
    if want rust; then
      if have cargo; then
        echo "  rust   → cargo install --version $ENGINE_PIN candor-scan candor-query"
        # Pin to ENGINE_PIN (NOT latest) so the whole family stays at one version — an unpinned `cargo install`
        # fetched crates.io's newest and split the family (rust ahead of the pinned jvm/ts).
        cargo install -q --force --version "$ENGINE_PIN" candor-scan candor-query 2>/dev/null && echo "         ✔ $(candor-scan --version 2>/dev/null | head -1)" || echo "         ✘ cargo install failed (see: cargo install --version $ENGINE_PIN candor-scan candor-query)"
      else
        echo "  rust   → skipped (no Rust toolchain; install rustup to enable the Rust engine)"
      fi
    fi
    # --- Swift engine: a released macOS binary from 0.27, source build below that ---
    # Through 0.26 candor-swift shipped NO release assets — its workflow built, tested, smoked and cut a
    # release, then attached nothing — so this could only tell a Mac user to install a Swift toolchain and
    # build from source. That was the entire install story for `privacy-manifest`, a swift-only capability
    # with a case study written about it: the one feature nobody could install to try.
    if want swift; then
      if [ "$os" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
        mkdir -p "$CDBIN"
        sw="https://github.com/tombaldwin/candor-swift/releases/download/v$ENGINE_PIN/candor-swift-macos-arm64"
        if curl -fsSL -o "$CDBIN/candor-swift.tmp" "$sw" 2>/dev/null; then
          chmod +x "$CDBIN/candor-swift.tmp"; mv "$CDBIN/candor-swift.tmp" "$CDBIN/candor-swift"
          echo "  swift  → native binary (candor-swift-macos-arm64), no Swift toolchain required"
          echo "         ✔ $("$CDBIN/candor-swift" --version 2>/dev/null | head -1)"
        else
          rm -f "$CDBIN/candor-swift.tmp"
          if have swift; then
            echo "  swift  → no published binary for v$ENGINE_PIN — build from the candor-swift repo: swift build -c release"
          else
            echo "  swift  → optional (no published binary for v$ENGINE_PIN; needs macOS + a Swift toolchain)"
          fi
        fi
      elif [ "$os" = Darwin ]; then
        echo "  swift  → the published binary is macos-arm64; on Intel build from the candor-swift repo"
      else
        echo "  swift  → macOS only (build from source elsewhere)"
      fi
    fi
    # We're already online — refresh the version cache and report any release beyond the pin (a point
    # release is spec-compatible; a new line moves the family). Adopt either by moving the umbrella.
    refresh_update_cache
    newest=$(newest_beyond_pin)
    if [ -n "$newest" ]; then
      echo ""
      echo "  ↑ $(newer_kind "$newest") is available on the channel, beyond the pinned $ENGINE_PIN."
      echo "    Adopt it by moving the whole family together: brew upgrade candor"
    fi
    echo ""
    # doctor as an informational summary — but update must NOT inherit its exit 1 for a merely-absent
    # OPTIONAL engine (rust/swift needing a toolchain). A real download failure already printed "✘".
    "$0" doctor || true
    exit 0;;
  doctor)
    # one-shot install check: each engine's presence + version, and SPEC agreement (the interop
    # contract — matching `spec` matters; build versions may differ per the versioning ladder).
    # If update-check is opted in and the cache is stale, this is where the (once/day) refresh happens.
    maybe_refresh_update_cache
    rc=0; specs=""
    report() { # $1 name, $2 version-line-or-empty, $3 hint
      if [ -n "$2" ]; then
        printf "  %-14s %s\n" "$1" "$2"
        s=$(printf "%s" "$2" | sed -n 's/.*(spec \([0-9.]*\)).*/\1/p'); [ -n "$s" ] && specs="$specs $s"
      else
        printf "  %-14s MISSING — %s\n" "$1" "$3"; rc=1
      fi
    }
    rb="$(rust_bin candor-scan 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust scan" "$v" "run \`candor update rust\` (needs a Rust toolchain)"
    rb="$(rust_bin candor-query 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust query" "$v" "run \`candor update rust\`"
    if have candor-java; then v=$(candor-java --version 2>/dev/null | head -1)
    elif [ -x "$CDBIN/candor-java" ]; then v=$("$CDBIN/candor-java" --version 2>/dev/null | head -1)
    else jar="${CANDOR_JAVA_JAR:-$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)}"
         { [ -n "$jar" ] && [ -f "$jar" ]; } && v=$(java -jar "$jar" --version 2>/dev/null | head -1) || v=""; fi
    report "jvm" "$v" "run \`candor update\` to fetch it"
    if have candor-ts; then v=$(candor-ts --version 2>/dev/null | head -1)
    else v=$(npx -y "candor-ts@$ENGINE_PIN" --version 2>/dev/null | head -1); [ -n "$v" ] && v="$v (via npx)"; fi
    report "ts" "$v" "install Node — the ts engine then runs via npx, no install"
    if swb="$(rust_bin candor-swift 2>/dev/null)"; then report "swift" "$("$swb" --version 2>/dev/null | head -1)" ""
    else printf "  %-14s not installed (optional — build from candor-swift)\n" "swift"; fi
    u=$(printf "%s\n" $specs | sort -u | grep -c .)
    if [ "$u" -gt 1 ]; then
      echo "  ✘ SPEC DRIFT: installed engines declare different spec versions ($(printf "%s" "$specs" | tr ' ' ',' | sed 's/^,//')) — upgrade the stragglers."; rc=1
    elif [ "$u" -eq 1 ]; then
      echo "  ✔ all installed engines agree on spec $(printf "%s\n" $specs | sort -u)"
    fi
    # ⟨0.24⟩ AGREEMENT IS NOT CURRENCY. The check above proves the installed engines agree with EACH OTHER
    # — and TWO STALE ENGINES AGREE WITH EACH OTHER PERFECTLY. On 2026-08-01 the installed candor-query was
    # twelve days behind its repo while doctor reported a clean bill, and an agent sent to read "the
    # reference implementation's output" through it would have confirmed the OLD wire shape as normative.
    # So on a machine that HAS the sources, compare each install against its own repo and say so. This is
    # deliberately dev-only and advisory: a user without the repos sees nothing new, and `candor outdated`
    # remains the registry-facing check.
    drift=0
    for pair in "candor-rust:candor-scan" "candor-rust:candor-query" "candor-swift:candor-swift" "candor-ts:candor-ts"; do
      repo="${pair%%:*}"; eng="${pair##*:}"; src="$HOME/git/$repo"
      [ -d "$src/.git" ] || continue
      inst="$(command -v "$eng" 2>/dev/null)" || continue
      [ -n "$inst" ] || continue
      # newest tracked source file in the repo vs the installed binary's mtime
      newest=$(find "$src" -name '*.rs' -o -name '*.swift' -o -name '*.mjs' 2>/dev/null \
               | grep -v -e '/\.build/' -e '/target/' -e '/node_modules/' \
               | xargs stat -f '%m' 2>/dev/null | sort -rn | head -1)
      ibin=$(stat -f '%m' "$inst" 2>/dev/null)
      if [ -n "$newest" ] && [ -n "$ibin" ] && [ "$newest" -gt "$ibin" ]; then
        [ "$drift" -eq 0 ] && echo ""
        printf "  ⚠ %-14s installed build is OLDER than %s's sources (%s vs %s)\n" \
          "$eng" "$repo" "$(date -r "$ibin" +%Y-%m-%d)" "$(date -r "$newest" +%Y-%m-%d)"
        drift=1
      fi
    done
    [ "$drift" -eq 1 ] && echo "    → the engines above agree with each other but not with your checkout; rebuild + reinstall before trusting a measurement against them"
    exit $rc;;
  init)
    # candor init — stand up the effect gate in one command (engine picked by manifest):
    #   1. scan the project                         → .candor/report*
    #   2. PROPOSE a starter policy from what the code already does → .candor/arch.policy
    #   3. record the baseline (the regression ratchet)             → .candor/baseline*
    #   4. wire .candor/config (policy + baseline keys)
    # Existing files are never clobbered. Review arch.policy (every proposed rule currently
    # passes), commit .candor/, and add the gate to CI (see the adopt/ dir for templates).
    shift
    case "${1:-}" in
      -h|--help)
        echo "candor init [<dir>] — stand up the gate in one command:"
        echo "  scan the project · propose an architecture policy from what it already does · record a"
        echo "  baseline (the regression ratchet) · wire .candor/config · generate a CI workflow."
        echo "Every proposed rule passes at adoption, so it's safe. Existing files are never clobbered."
        echo "In a monorepo, run it per project subdir — each writes a root-level workflow scoped to it."
        exit 0;;
    esac
    idir="${1:-.}"
    [ -d "$idir" ] || die "init: '$idir' is not a directory"
    mkdir -p "$idir/.candor"
    langs="$(detect_langs "$idir")"
    [ -n "$langs" ] || die "init: can't tell what language $idir is (no Cargo.toml / package.json / build.gradle / Package.swift)."
    nlang=$(set -- $langs; echo $#)
    echo "candor init — $idir ($langs)"
    # ENSURE the engines (init is a setup command: fetch what's missing, unlike scan which just errors).
    for lang in $langs; do ensure_engine "$lang" >/dev/null 2>&1 || echo "  · could not set up the $lang engine automatically — run \`candor update $lang\` and re-run"; done
    # SCAN each detected language (a mixed repo → one report per language in .candor/).
    for lang in $langs; do
      scanout="$( cd "$idir" && CANDOR_DISPATCH_NOEXEC=1 engine_scan "$lang" . 2>&1 )" || {
        echo "  ✘ $lang scan failed:"; printf '%s\n' "$scanout" | tail -4 | sed 's/^/      /'; }
    done
    # collect the report files into an ARRAY (per-element quoted — a path with a space must not split),
    # with the SAME full sidecar/ledger exclusion the query router uses (not just callgraph/hierarchy).
    reps=()
    for f in "$idir"/.candor/report*.json; do
      [ -e "$f" ] || continue
      is_sidecar "$f" && continue
      reps+=("$f")
    done
    [ "${#reps[@]}" -gt 0 ] || die "init: no report was written — fix the failure above and re-run"
    echo "  ✔ scanned → ${#reps[@]} report(s)"
    tooldir="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
    # PROPOSE a policy from every report (concatenated into one arch.policy — each engine only matches
    # its own layers, so a combined polyglot policy is safe). Never clobber an existing one.
    if [ -f "$idir/.candor/arch.policy" ]; then
      echo "  · .candor/arch.policy exists — kept (delete it and re-run to re-propose)"
    elif [ -x "$tooldir/adopt/candor-init" ] || [ -f "$tooldir/adopt/candor-init" ]; then
      : > "$idir/.candor/arch.policy.tmp"
      pi=0; for r in "${reps[@]}"; do
        # only the FIRST report's rules carry the comment header; the rest append rules-only (re-audit #18).
        if [ "$pi" -eq 0 ]; then python3 "$tooldir/adopt/candor-init" "$r" >> "$idir/.candor/arch.policy.tmp" 2>/dev/null
        else python3 "$tooldir/adopt/candor-init" "$r" --no-header >> "$idir/.candor/arch.policy.tmp" 2>/dev/null; fi
        pi=$((pi+1))
      done
      if [ -s "$idir/.candor/arch.policy.tmp" ]; then mv "$idir/.candor/arch.policy.tmp" "$idir/.candor/arch.policy"
        echo "  ✔ proposed .candor/arch.policy (every rule currently passes — review, keep what matches intent)"
      else rm -f "$idir/.candor/arch.policy.tmp"; echo "  · policy proposal skipped (the inference tool could not read the report)"; fi
    else
      echo "  · policy proposal skipped (adopt/candor-init not found beside the dispatcher)"
    fi
    # BASELINE each report → its sibling baseline (never clobber; per-engine, since a baseline is only
    # comparable to its OWN engine's report — a shared one would fail-closed on the others).
    for f in "${reps[@]}"; do
      b="$(dirname "$f")/$(basename "$f" | sed 's/^report/baseline/')"
      cgf="${f%.json}.callgraph.json"; cgb="${b%.json}.callgraph.json"
      if [ -f "$b" ]; then echo "  · $(basename "$b") exists — kept"
      else cp "$f" "$b"; [ -f "$cgf" ] && cp "$cgf" "$cgb"   # copy the callgraph sidecar too (the ⟨0.16⟩ guard needs it)
        echo "  ✔ baseline → ${b#"$idir"/}"; fi
    done
    # WIRE the config. policy is safe to share. The baseline key is per-engine, so only wire it for a
    # single-language repo; a polyglot repo gates each language with its own baseline (shown below).
    cfg="$idir/.candor/config"; touch "$cfg"
    grep -q "^policy" "$cfg" 2>/dev/null || { [ -f "$idir/.candor/arch.policy" ] && printf 'policy .candor/arch.policy\n' >> "$cfg" && echo "  ✔ config: policy wired"; }
    if [ "$nlang" -eq 1 ]; then
      bl="$(ls "$idir"/.candor/baseline*.json 2>/dev/null | grep -vE 'callgraph|hierarchy' | head -1)"
      grep -q "^baseline" "$cfg" 2>/dev/null || { [ -n "$bl" ] && printf 'baseline %s\n' ".candor/$(basename "$bl")" >> "$cfg" && echo "  ✔ config: baseline wired (a formerly-pure fn turning effectful now fails the gate)"; }
    else
      echo "  · polyglot repo — the baseline is per-engine (a shared one fails-closed on the others), so"
      echo "    it isn't wired to config. Gate each language in CI with its own engine + baseline:"
      for f in "$idir"/.candor/baseline*.json; do
        case "$f" in *callgraph*|*hierarchy*) continue;; esac
        [ -e "$f" ] || continue
        eng=candor-scan; case "$f" in *.jvm.json) eng=candor-java;; *.Swift.json) eng=candor-swift;; *.JS.json|*/baseline.json) eng=candor-ts;; esac
        echo "      CANDOR_BASELINE=.candor/$(basename "$f") $eng . --gate-json v.json"
      done
    fi
    # .gitignore the regenerated scan artifacts so `commit .candor/` tracks only the DURABLE files
    # (baseline*, arch.policy, config); report*.json et al. regenerate on every scan and would otherwise
    # churn the diff and let a stale committed report mislead the dashboard (persona-audit fix).
    gi="$idir/.candor/.gitignore"
    if [ ! -f "$gi" ]; then
      { echo "# candor: ignore regenerated / runtime output — commit baseline*, arch.policy and config only."
        echo "report*.json"
        echo "activity.jsonl"          # the Stop-hook's per-session runtime log (re-audit: was committed)
        echo "verdict*.json"           # local gate-verdict runs (`--gate-json verdict.json`)
        echo "*.gate-json"; } > "$gi"
      echo "  ✔ .candor/.gitignore (ignores report*/activity.jsonl/verdict* — commit baseline*/arch.policy/config)"
    fi
    # ALSO ignore the CI verdict file the generated workflow writes at the repo root (re-audit #7).
    rgi="$idir/.gitignore"
    if [ -f "$rgi" ] && ! grep -q '^candor-verdict.json' "$rgi" 2>/dev/null; then
      printf 'candor-verdict.json\n' >> "$rgi"
    elif [ ! -f "$rgi" ]; then
      printf '# candor: the CI gate verdict is ephemeral\ncandor-verdict.json\n' > "$rgi"
    fi
    # CI WORKFLOW: the durable value is the gate ENFORCED on every push. Drop a ready GitHub Actions
    # workflow (single-language; never clobber). The gate step reads policy + baseline from .candor/config,
    # so it's just "install the pinned engine + candor <scan> --gate-json". rust/ts are no-build drop-ins;
    # java/swift carry a clearly-marked build/setup step (a starting point, not a false "it just works").
    #
    # PLACEMENT (persona-audit fix): GitHub Actions only reads .github/workflows/ at the REPO ROOT, so a
    # workflow written under a subdir (`candor init api`) silently never runs. If init runs in a subdir of a
    # git repo, place the workflow at the repo root, name it + scope it per-subdir (a distinct file, so it
    # never collides with a sibling `candor init`), and run its steps in the subdir via working-directory.
    abs_idir="$(cd "$idir" && pwd)"; gitroot=""
    have git && gitroot="$(cd "$idir" && git rev-parse --show-toplevel 2>/dev/null)"
    wfdir="$idir/.github/workflows"; wfname="candor.yml"; jobname="candor"; wdir=""; wfloc=".github/workflows/candor.yml"
    if [ -n "$gitroot" ] && [ "$gitroot" != "$abs_idir" ]; then
      rel="${abs_idir#"$gitroot"/}"
      slug="$(printf '%s' "$rel" | tr '/ ' '--' | tr -cd 'A-Za-z0-9._-')"
      wfdir="$gitroot/.github/workflows"; wfname="candor-$slug.yml"; jobname="candor-$slug"; wdir="$rel"
      wfloc=".github/workflows/$wfname (repo root)"
    fi
    wf="$wfdir/$wfname"
    pin="$ENGINE_PIN"
    if [ "$nlang" -eq 1 ] && [ ! -f "$wf" ]; then
      mkdir -p "$wfdir"
      [ -n "$wdir" ] && echo "  · monorepo: $rel is below the repo root — GitHub reads workflows only from the root,"
      [ -n "$wdir" ] && echo "    so the gate is written to $wfloc, scoped to $rel/."
      { echo "# candor architecture gate — generated by \`candor init\`."
        echo "# Fails the build when an edit crosses a declared boundary (.candor/arch.policy) or a"
        echo "# function gains an effect vs the committed baseline (AS-EFF-005). Policy + baseline are"
        echo "# read from .candor/config — commit .candor/ for this to work."
        echo "name: $jobname"
        echo "on:"
        echo "  push: { branches: [main] }"
        echo "  pull_request:"
        echo "permissions: { contents: read }"
        echo "jobs:"
        echo "  $jobname:"
        if [ "$langs" = swift ]; then echo "    runs-on: macos-14"; else echo "    runs-on: ubuntu-latest"; fi
        [ -n "$wdir" ] && { echo "    defaults:"; echo "      run:"; echo "        working-directory: $wdir"; }
        echo "    steps:"
        echo "      - uses: actions/checkout@v4"
        case "$langs" in
          rust)  echo "      - uses: dtolnay/rust-toolchain@stable"
                 echo "      - uses: Swatinem/rust-cache@v2   # keep the gate off the multi-minute cold-compile path"
                 echo "      - run: cargo install candor-scan --version '=$pin' --locked   # pin tracks .candor/baseline's engine — bump both together"
                 echo "      - run: candor-scan . --gate-json candor-verdict.json";;
          ts)    echo "      - uses: actions/setup-node@v4"
                 echo "        with: { node-version: 20 }"
                 echo "      - run: npx -y candor-ts@$pin . --gate-json candor-verdict.json   # pin tracks .candor/baseline's engine — bump both together";;
          swift) # macos-14 is arm64, which the released binary targets. This arm did not exist before
                 # 0.27 because candor-swift published no binary at all — `init` printed a note telling a
                 # Swift user to go and build one, which is a dead end in a generator whose entire job is
                 # producing a workflow that runs.
                 echo "      - run: |"
                 echo "          curl -fsSL -o candor-swift https://github.com/tombaldwin/candor-swift/releases/download/v$pin/candor-swift-macos-arm64"
                 echo "          chmod +x candor-swift"
                 echo "      - run: ./candor-swift . --gate-json candor-verdict.json"
                 echo "      # Per SHIPPED BINARY, not per repo: add --target <name> on a multi-target package,"
                 echo "      # and one privacy-manifest step per Info.plist you ship."
                 echo "      # - run: ./candor-swift privacy-manifest --verify Resources/Info.plist";;
          java)  echo "      - uses: actions/setup-java@v4"
                 echo "        with: { distribution: temurin, java-version: '21' }"
                 echo "      - run: mvn -q compile           # EDIT: your build (or ./gradlew classes)"
                 echo "      - run: |"
                 echo "          curl -fsSL -o candor-java https://github.com/tombaldwin/candor-java/releases/download/v$pin/candor-linux-x64"
                 echo "          chmod +x candor-java"
                 echo "      - run: ./candor-java target/classes --gate-json candor-verdict.json  # EDIT: your compiled-classes dir";;
        esac
      } > "$wf"
      case "$langs" in
        rust|ts|swift) echo "  ✔ CI workflow → $wfloc (ready — gates on your next push)";;
        *)       echo "  ✔ CI workflow → $wfloc (review the marked EDIT lines: your build + engine setup)";;
      esac
    elif [ -f "$wf" ]; then
      echo "  · $wfloc exists — kept"
    fi
    # Loud notice for manifests in SUBDIRECTORIES init didn't cover (detect_langs only sees the top level) —
    # the polyglot blind spot where a root Cargo.toml + web/package.json left the TS half silently ungated.
    subdirs="$(find "$idir" \( -name .git -o -name node_modules -o -name target -o -name build -o -name .build -o -name dist -o -name vendor -o -name .candor -o -name .github \) -prune -o \
      -type f \( -name Cargo.toml -o -name package.json -o -name Package.swift -o -name pom.xml -o -name build.gradle -o -name build.gradle.kts \) -print 2>/dev/null \
      | while IFS= read -r m; do d="$(cd "$(dirname "$m")" 2>/dev/null && pwd)"; [ -n "$d" ] && [ "$d" != "$abs_idir" ] && printf '%s\n' "${d#"$abs_idir"/}"; done | sort -u | head -12)"
    if [ -n "$subdirs" ]; then
      echo ""
      echo "  ⚠ other project manifests below $idir — init scanned only the top level ($langs). NOT gated:"
      printf '%s\n' "$subdirs" | sed 's|^|      |'
      echo "    gate each with its own:  candor init <subdir>   (writes a root-level workflow scoped to it)"
    fi
    # FIRST LOOK: end the first minute with an insight, not file paths — the tour opener, inline
    # (single-language only: a polyglot .candor/ holds several reports and tour needs one).
    if [ "$nlang" -eq 1 ]; then
      firstlook="$( cd "$idir" && CANDOR_NO_FRESHNESS=1 CANDOR_DISPATCH_NOEXEC=1 route_query tour 3 2>/dev/null | head -14 )"
      if [ -n "$firstlook" ]; then
        echo ""
        echo "First look — the most surprising reaches in this code:"
        printf '%s\n' "$firstlook" | sed 's/^/  /'
      fi
    fi
    echo ""
    if [ "$nlang" -eq 1 ] && [ -f "$wf" ]; then
      echo "Next: review .candor/arch.policy + $wfloc, then commit .candor/ and the"
      echo "workflow. The gate runs on your next push — a boundary crossing or a gained effect fails it."
    else
      echo "Next: review .candor/arch.policy, commit .candor/ (config, arch.policy, baseline*), and gate"
      echo "each language in CI (one step per engine — \`candor scan . --gate-json\` reads the config)."
    fi
    exit 0;;
  mcp|lsp)
    # Bring the agent/editor servers under the umbrella: `candor mcp` / `candor lsp` instead of the
    # `npx -y -p candor-ts candor-mcp` incantation. Both are hosted by the candor-ts package (they read
    # ANY engine's report). Prefer a global install; else run via npx pinned to the engine line.
    bin="candor-$verb"; shift
    # --help/-h: the servers themselves print nothing useful, so the umbrella explains how to WIRE them
    # (the persona audit's one place a novice was genuinely stuck — no paste-ready config anywhere).
    case "${1:-}" in
      -h|--help)
        if [ "$verb" = mcp ]; then
          cat <<'H'
candor mcp — the MCP server, so a coding agent can query candor's reports during a turn
(blast radius, whatif, gate verdict). It reads whatever engine's report is in .candor/, so
run `candor scan .` (or `candor init`) first.

Wire it into Claude Code (project-local .mcp.json, portable — resolves `candor` on PATH):

  { "mcpServers": { "candor": { "command": "candor", "args": ["mcp"] } } }

  or:  claude mcp add candor -- candor mcp
  or:  candor mcp install         (writes/merges that .mcp.json for you, here)

Any MCP client works — point its server config at `candor mcp`.
H
        else
          cat <<'H'
candor lsp — the language server: CodeLens + diagnostics from candor's reports, in your
editor, live. It reads whatever engine's report is in .candor/, so run `candor scan .` first.

Point your editor's LSP client at the command `candor lsp` (stdio). For VS Code, the candor
extension does this for you; for a generic client, register a server with command `candor`,
args `["lsp"]`.
H
        fi
        exit 0;;
      install)
        [ "$verb" = mcp ] || die "candor lsp has no \`install\` (editors register the LSP their own way — \`candor lsp --help\`)."
        shift || true; mdir="${1:-.}"; [ -d "$mdir" ] || die "mcp install: '$mdir' is not a directory"
        mrepo="$(cd "$mdir" && pwd)"; mfile="$mrepo/.mcp.json"
        [ -f "$mfile" ] && cp "$mfile" "$mfile.bak"
        mout="$(CANDOR_MCP_FILE="$mfile" python3 - <<'PY'
import json, os, sys
path = os.environ["CANDOR_MCP_FILE"]; data = {}
if os.path.exists(path):
    try:
        with open(path) as fh: data = json.load(fh)
        if not isinstance(data, dict): print("EXISTING .mcp.json is not a JSON object — leaving it untouched.", file=sys.stderr); raise SystemExit(3)
    except SystemExit: raise
    except Exception as e:
        print(f"EXISTING .mcp.json is not valid JSON ({e}) — fix or remove it, then re-run.", file=sys.stderr); raise SystemExit(3)
servers = data.setdefault("mcpServers", {})
if not isinstance(servers, dict): print(".mcp.json .mcpServers is not an object — leaving it untouched.", file=sys.stderr); raise SystemExit(3)
if "candor" in servers: print("ALREADY", end=""); raise SystemExit(0)
servers["candor"] = {"command": "candor", "args": ["mcp"]}
with open(path, "w") as fh: json.dump(data, fh, indent=2); fh.write("\n")
print("WIRED", end="")
PY
)"; mrc=$?; [ "$mrc" -eq 0 ] || exit "$mrc"
        case "$mout" in
          ALREADY) echo "candor mcp — already wired in .mcp.json (left as-is).";;
          WIRED)   echo "wired → .mcp.json (portable — command \`candor mcp\`). Restart your agent, and run \`candor scan .\` so there's a report to read.";;
          *)       die "mcp install: unexpected result wiring .mcp.json.";;
        esac
        exit 0;;
    esac
    if have "$bin"; then run "$bin" "$@"
    elif have node; then run npx -y -p "candor-ts@$ENGINE_PIN" "$bin" "$@"
    else die "\`candor $verb\` needs the candor-ts package — install Node (it then runs via npx), or \`npm i -g candor-ts\`."; fi;;
  hook)
    # candor hook — wire the edit-time Stop hook (Claude Code) into this repo in one command. It locates
    # the shipped hook scripts (dev checkout OR brew share dir), detects the language, finds the committed
    # baseline `candor init` wrote, composes the tailored Stop-hook COMMAND, and either PRINTS the ready
    # .claude/settings.json snippet (`candor hook`) or MERGES it into .claude/settings.json (`candor hook install`).
    shift || true
    case "${1:-}" in
      -h|--help)
        echo "candor hook [install|uninstall] [<dir>] — wire candor's end-of-turn gate into your coding agent (Claude Code)."
        echo ""
        echo "  candor hook              print the ready .claude/settings.json Stop-hook snippet (tailored to your language)"
        echo "  candor hook install      merge it into .claude/settings.json for you (idempotent; backs up an existing file)"
        echo "  candor hook uninstall    remove candor's Stop hook from .claude/settings.json (leaves your other hooks)"
        echo ""
        echo "Runs at the END of each agent turn (not per keystroke): scans the result, diffs effects vs the"
        echo "committed baseline, and blocks the turn once so the agent fixes a new effect / boundary crossing"
        echo "before yielding to you. Run \`candor init\` first — it writes the baseline the hook diffs against."
        exit 0;;
    esac
    hmode=print
    case "${1:-}" in
      install)          hmode=install; shift || true;;
      uninstall|remove) hmode=uninstall; shift || true;;
    esac
    hdir_target="${1:-.}"
    [ -d "$hdir_target" ] || die "hook: '$hdir_target' is not a directory"
    hrepo="$(cd "$hdir_target" && pwd)"
    settings="$hrepo/.claude/settings.json"
    if [ "$hmode" = uninstall ]; then
      # Remove candor's Stop hook, leaving any other Stop hooks intact. Matches both the portable
      # `candor hook-run` wiring and any legacy `stop-hook.sh` absolute-path wiring.
      [ -f "$settings" ] || die "hook uninstall: no .claude/settings.json in $hrepo — nothing to remove."
      cp "$settings" "$settings.bak"
      uout="$(CANDOR_SETTINGS="$settings" python3 - <<'PY'
import json, os, sys
path = os.environ["CANDOR_SETTINGS"]
try:
    with open(path) as fh: data = json.load(fh)
except Exception as e:
    print(f"settings.json is not valid JSON ({e}).", file=sys.stderr); raise SystemExit(3)
stop = (data.get("hooks") or {}).get("Stop")
if not isinstance(stop, list): print("NONE", end=""); raise SystemExit(0)
def is_candor(group):
    for h in (group.get("hooks", []) if isinstance(group, dict) else []):
        c = str(h.get("command", "")) if isinstance(h, dict) else ""
        if "hook-run" in c or "stop-hook.sh" in c: return True
    return False
kept = [g for g in stop if not is_candor(g)]
if len(kept) == len(stop): print("NONE", end=""); raise SystemExit(0)
data["hooks"]["Stop"] = kept
with open(path, "w") as fh: json.dump(data, fh, indent=2); fh.write("\n")
print("REMOVED", end="")
PY
)"; urc=$?; [ "$urc" -eq 0 ] || exit "$urc"
      case "$uout" in
        REMOVED) echo "candor hook — removed from .claude/settings.json (backup: settings.json.bak). Restart Claude Code.";;
        NONE)    echo "candor hook — no candor Stop hook found in .claude/settings.json (nothing to remove).";;
        *)       die "hook uninstall: unexpected result.";;
      esac
      exit 0
    fi
    hd="$(hook_dir)"
    [ -n "$hd" ] || die "hook: can't find the hook scripts (looked beside the dispatcher and in share/candor/hooks). Set CANDOR_HOOK_DIR to the integrations/claude-code dir."
    # Detect the language (single-language only — a Stop hook scans one engine's output).
    hlangs="$(detect_langs "$hrepo")"; hn=$(set -- $hlangs; echo $#)
    if [ "$hn" -eq 0 ]; then die "hook: can't tell what language $hrepo is (no Cargo.toml / package.json / build.gradle / Package.swift)."; fi
    if [ "$hn" -gt 1 ]; then
      echo "candor hook — $hrepo is polyglot ($hlangs)." >&2
      echo "The edit-time hook scans ONE engine's output, so each language wires its own hook (one Stop entry per language)." >&2
      echo "Re-run \`candor hook\` per language subdir, or wire them by hand from integrations/claude-code/README.md." >&2
      exit 2
    fi
    # Find the committed baseline the hook diffs against (exclude the callgraph/hierarchy sidecars). No
    # baseline → the hook has nothing to compare to; point at `candor init`.
    hbl=""
    for f in "$hrepo"/.candor/baseline*.json; do
      [ -e "$f" ] || continue
      is_sidecar "$f" && continue
      hbl=".candor/$(basename "$f")"; break
    done
    if [ -z "$hbl" ]; then
      echo "candor hook — no baseline in $hrepo/.candor/ (the hook needs a last-known-good to diff against)." >&2
      echo "Run \`candor init\` here first — it scans, proposes a policy, and writes the baseline. Then re-run \`candor hook\`." >&2
      exit 2
    fi
    # Only wire a policy if one exists.
    hpol=""; [ -f "$hrepo/.candor/arch.policy" ] && hpol="CANDOR_POLICY=.candor/arch.policy "
    # Compose a PORTABLE command: `candor hook-run` (resolved on PATH) carries only repo-relative env, so the
    # committed settings.json has no machine-specific absolute path in it. hook-run finds the scripts itself.
    hgradle_note=""
    case "$hlangs" in
      rust)  hcmd="CANDOR_LANG=rust CANDOR_SRC=. ${hpol}CANDOR_REVIEW_BASELINE=$hbl candor hook-run";;
      ts)    hcmd="CANDOR_LANG=ts CANDOR_SRC=. ${hpol}CANDOR_REVIEW_BASELINE=$hbl candor hook-run";;
      swift) hcmd="CANDOR_LANG=swift CANDOR_SRC=. ${hpol}CANDOR_REVIEW_BASELINE=$hbl candor hook-run";;
      java)  hcmd="mvn -q compile 1>&2 && CANDOR_LANG=java CANDOR_CLASSES=target/classes ${hpol}CANDOR_REVIEW_BASELINE=$hbl candor hook-run"
             hgradle_note="Gradle: change the build to \`./gradlew -q classes 1>&2\` and CANDOR_CLASSES=build/classes/java/main.";;
    esac
    if [ "$hmode" = print ]; then
      # PRINT the ready .claude/settings.json Stop-hook snippet (valid JSON via python3) + where it goes.
      CANDOR_HCMD="$hcmd" python3 - <<'PY'
import json, os
cmd = os.environ["CANDOR_HCMD"]
snippet = {"hooks": {"Stop": [ {"hooks": [ {"type": "command", "command": cmd, "timeout": 120} ]} ]}}
print(json.dumps(snippet, indent=2))
PY
      echo ""
      echo "→ put this in the project's .claude/settings.json (merge into an existing \"hooks\".\"Stop\" array; keep all Stop hooks in one file)."
      echo "→ portable — no machine-specific paths, so it's safe to COMMIT for the whole team (each teammate needs \`candor\` on PATH)."
      echo "→ or let candor merge it for you:  candor hook install"
      echo "→ fully restart Claude Code after editing settings.json (a /clear is not enough)."
      [ -n "$hgradle_note" ] && echo "→ $hgradle_note"
      exit 0
    fi
    # install: MERGE the candor Stop hook into <repo>/.claude/settings.json (create if absent; never clobber
    # other hooks; skip if already wired; back up an existing file first).
    mkdir -p "$hrepo/.claude"
    [ -f "$settings" ] && cp "$settings" "$settings.bak"
    hout="$(CANDOR_HCMD="$hcmd" CANDOR_SETTINGS="$settings" python3 - <<'PY'
import json, os, sys
cmd = os.environ["CANDOR_HCMD"]; path = os.environ["CANDOR_SETTINGS"]
data = {}
if os.path.exists(path):
    try:
        with open(path) as fh: data = json.load(fh)
        if not isinstance(data, dict): print("EXISTING settings.json is not a JSON object — leaving it untouched.", file=sys.stderr); raise SystemExit(3)
    except SystemExit: raise
    except Exception as e:
        print(f"EXISTING settings.json is not valid JSON ({e}) — fix or remove it, then re-run.", file=sys.stderr); raise SystemExit(3)
hooks = data.setdefault("hooks", {})
if not isinstance(hooks, dict): print("settings.json .hooks is not an object — leaving it untouched.", file=sys.stderr); raise SystemExit(3)
stop = hooks.setdefault("Stop", [])
if not isinstance(stop, list): print("settings.json .hooks.Stop is not an array — leaving it untouched.", file=sys.stderr); raise SystemExit(3)
def has_candor(group):
    for h in (group.get("hooks", []) if isinstance(group, dict) else []):
        c = str(h.get("command", "")) if isinstance(h, dict) else ""
        if "hook-run" in c or "stop-hook.sh" in c: return True
    return False
if any(has_candor(g) for g in stop):
    print("ALREADY", end=""); raise SystemExit(0)
stop.append({"hooks": [ {"type": "command", "command": cmd, "timeout": 120} ]})
with open(path, "w") as fh: json.dump(data, fh, indent=2); fh.write("\n")
print("WIRED", end="")
PY
)"
    prc=$?
    [ "$prc" -eq 0 ] || exit "$prc"
    case "$hout" in
      ALREADY) echo "candor hook — already wired in .claude/settings.json (left as-is; re-running install is safe).";;
      WIRED)   echo "wired → .claude/settings.json (portable — safe to commit). Restart Claude Code."
               echo "  fires at the END of each agent turn (not per edit), and blocks the turn once so the agent fixes a new effect / boundary crossing before yielding to you."
               # ts runs via npx: the FIRST hook fire pays cold npx resolution (~a minute, needs network)
               # and can hit the hook timeout — pre-warm so the first live turn isn't a freeze (re-audit fix).
               [ "$hlangs" = ts ] && echo "  first run fetches candor-ts via npx (needs network) — run \`candor scan .\` once now to pre-warm, or \`npm i -g candor-ts\` to drop the npx wait."
               echo "  try it: ask the agent to make a pure function touch the network — the hook blocks the turn so it fixes it."
               echo "  remove it later with: candor hook uninstall"
               [ -n "$hgradle_note" ] && echo "  $hgradle_note";;
      *)       die "hook: unexpected result wiring settings.json.";;
    esac
    exit 0;;
  hook-run)
    # Internal entry the wired Stop hook invokes as `candor hook-run` — the PORTABILITY fix. It resolves
    # `candor` on PATH and finds the shipped hook scripts ITSELF, so a committed .claude/settings.json works
    # for every teammate's brew install, not only the machine that ran `candor hook` (which used to bake in
    # /Users/<me>/git/... absolute paths). Env in: CANDOR_LANG picks the review script + default scan
    # command; CANDOR_REVIEW_BASELINE / CANDOR_POLICY / CANDOR_SRC / CANDOR_CLASSES pass through. stdin (the
    # Claude Code hook JSON) flows straight into stop-hook.sh, which owns the 0/1/2 + block-once contract.
    shift || true
    # hook-run reads the Claude Code Stop-hook JSON on stdin. Run BY HAND (a terminal), there's no JSON and
    # no EOF, so it would hang forever with no output — and `candor hook install` literally invites "try it".
    # If stdin is a TTY, say what it's for and exit cleanly instead of hanging silently (re-audit fix).
    if [ -t 0 ]; then
      echo "candor hook-run — this is the edit-time Stop hook; it expects Claude Code hook JSON on stdin and" >&2
      echo "does nothing run by hand. It's wired by \`candor hook install\` and fires at the end of each agent" >&2
      echo "turn. To exercise the gate directly: \`candor scan . --policy .candor/arch.policy\`." >&2
      exit 0
    fi
    hd="$(hook_dir)"
    [ -n "$hd" ] || { echo "candor hook-run: the hook scripts aren't installed (looked beside the dispatcher and in share/candor/hooks). Reinstall candor, or set CANDOR_HOOK_DIR." >&2; exit 2; }
    case "${CANDOR_LANG:-}" in
      java)  : "${CANDOR_REVIEW:=$hd/candor-review.sh}";;
      rust)  : "${CANDOR_REVIEW:=$hd/candor-review-source.sh}"; : "${CANDOR_SCAN:=candor-scan}";;
      ts)    : "${CANDOR_REVIEW:=$hd/candor-review-source.sh}"; : "${CANDOR_SCAN:=npx -y candor-ts@$ENGINE_PIN}";;
      swift) : "${CANDOR_REVIEW:=$hd/candor-review-source.sh}"; : "${CANDOR_SCAN:=candor-swift}";;
      *)     : "${CANDOR_REVIEW:=$hd/candor-review-source.sh}";;
    esac
    export CANDOR_REVIEW CANDOR_SCAN
    exec "$hd/stop-hook.sh" "$@";;
  scan) shift; route_scan "$@";;
  *)
    # not a known action: a real path/dir is a scan target (candor <dir> = scan); anything else is
    # almost certainly a typo'd action — suggest the nearest match instead of handing it to a scanner.
    if [ ! -e "$verb" ]; then
      sugg=$(python3 - "$verb" <<'PY' 2>/dev/null
import sys
actions = "init scan doctor engines update install upgrade outdated check config show where callers map containment diff reachable impact blindspots gains path tour whatif fix fix-gate unverified rewire parsepolicy agents".split()
v = sys.argv[1]
def d(a, b):
    if abs(len(a)-len(b)) > 2: return 99
    m = [[i+j if i*j==0 else 0 for j in range(len(b)+1)] for i in range(len(a)+1)]
    for i in range(1, len(a)+1):
        for j in range(1, len(b)+1):
            m[i][j] = min(m[i-1][j]+1, m[i][j-1]+1, m[i-1][j-1]+(a[i-1]!=b[j-1]))
    return m[-1][-1]
best = min(actions, key=lambda a: d(v, a))
if d(v, best) <= 2: print(best)
PY
)
      [ -n "$sugg" ] && die "unknown action '$verb' — did you mean \`candor $sugg\`? (\`candor --help\` lists them)"
      die "unknown action '$verb' and no such path — \`candor --help\` lists the actions; \`candor scan <dir>\` scans."
    fi
    route_scan "$@";;
esac
