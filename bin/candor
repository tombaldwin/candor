#!/usr/bin/env bash
# candor — the umbrella dispatcher (candor-spec §3.3.1). ONE `candor` command across every language.
#
#   • a QUERY (where/path/show/…) is routed by the DISCOVERED report's backend — the filename tail
#     `.JS` → TypeScript, `.jvm` → Java, `.Swift` → Swift, and everything else (Rust's `.scan` syntactic
#     backend plus the nightly-lint crate-types `.lib`/`.Executable`/`.Rlib`/…) → Rust.
#   • a SCAN (`candor scan .`, or `candor <dir>`) is routed by the project's manifest — Cargo.toml → Rust,
#     package.json / tsconfig.json → TypeScript, build.gradle / pom.xml / *.java → Java, Package.swift → Swift.
#
# It execs the matching engine's QUALIFIED CLI (candor-query, candor-ts-query, candor-java, candor-swift) —
# they all speak the same §3.3.1 grammar, so every flag and verb passes straight through. This owns the bare
# `candor` name so four language packages don't fight over it, and it NEVER guesses silently: an ambiguous
# project (or a missing engine) is a loud, actionable error, not a wrong-engine run.
#
# Set CANDOR_DISPATCH_DRYRUN=1 to print the resolved command instead of running it (used by the tests).

CDBIN="${CANDOR_CACHE:-$HOME/.candor}/bin"   # where candor-rust/install.sh stashes candor-scan + candor-query
QUERY_VERBS=" show where callers map containment diff reachable impact blindspots gains path tour whatif fix fix-gate unverified rewire parsepolicy agents "

die()  { echo "candor: $*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
# a Rust raw bin lives on PATH or under ~/.candor/bin
rust_bin() { if have "$1"; then echo "$1"; elif [ -x "$CDBIN/$1" ]; then echo "$CDBIN/$1"; else return 1; fi; }
# run (or, in dry-run, just announce) the resolved engine command
run() { if [ -n "${CANDOR_DISPATCH_DRYRUN:-}" ]; then echo "WOULD-RUN: $*"; exit 0; fi; exec "$@"; }

# candor-java is a jar: prefer a `candor-java` launcher on PATH, else `java -jar <jar>` (CANDOR_JAVA_JAR or a
# jar stashed under ~/.candor).
run_java() {
  if have candor-java; then run candor-java "$@"; fi
  local jar="${CANDOR_JAVA_JAR:-}"
  [ -n "$jar" ] || jar="$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)"
  [ -n "$jar" ] && [ -f "$jar" ] || die "a Java target, but no candor-java launcher and no jar — install a candor-java launcher or set CANDOR_JAVA_JAR."
  run java -jar "$jar" "$@"
}

# Sniff a token-less report FILE's backend from its §2.1 envelope (candor.toolchain / candor.version;
# meta.* for older rust shapes): jdk-* → jvm, swiftsyntax|candor-swift-* → Swift, node-*|candor-ts-* →
# JS, stable/nightly/scan-* → the open remainder (rust). Unreadable/absent envelope → JS (candor-ts is
# the only engine whose NATIVE primary shape is token-less, so it's the honest unreadable default).
sniff_backend() {
  python3 - "$1" 2>/dev/null <<'PYEOF' || echo JS
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    env = d.get("candor") or d.get("meta") or {}
    tc = str(env.get("toolchain", "")); v = str(env.get("version", ""))
except Exception:
    print("JS"); raise SystemExit
if tc.startswith("jdk"): print("jvm")
elif tc == "swiftsyntax" or v.startswith("candor-swift"): print("Swift")
elif tc.startswith("node") or v.startswith("candor-ts"): print("JS")
else: print("scan")
PYEOF
}

# ---- QUERY: route by the discovered report's backend ---------------------------------------------------
route_query() {
  local verb="$1"; shift
  # honor an explicit --report <loc>; else discover a `.candor/` ancestor from $PWD (the §3.3.1 rule)
  local a prev="" loc=""
  for a in "$@"; do [ "$prev" = "--report" ] && loc="$a"; prev="$a"; done
  # Resolve the locator to the report FILES by the ONE §3.3.1 rule (the same rule every engine applies):
  # a DIRECTORY → its `.candor/report` family; a `.json` path → that single report file; anything else →
  # a bare PREFIX (`<prefix>.<pkg>.<backend>.json`). No --report → discover a `.candor/` ancestor. The old
  # code always globbed `<dir>/report.*.json`, so a --report naming a non-`report`-basename prefix or a
  # direct .json file died with "no report" — a locator every engine accepts but the dispatcher refused.
  local files=() famprefix=""
  if [ -n "$loc" ]; then
    if [ -d "$loc" ]; then famprefix="$loc/.candor/report"; files=("$famprefix".*.json)
    elif [ "${loc%.json}" != "$loc" ] && [ -f "$loc" ]; then files=("$loc")
    else famprefix="$loc"; files=("$loc".*.json); fi
  else
    local d="$PWD" base=""
    while :; do [ -d "$d/.candor" ] && { base="$d/.candor/report"; break; }; [ "$d" = "/" ] && break; d="$(dirname "$d")"; done
    [ -n "$base" ] || die "no report — run \`candor scan\` first, or pass --report <locator>. (no .candor/ from $PWD upward)"
    famprefix="$base"; files=("$base".*.json)
  fi

  # the distinct backends present (the token before .json), excluding EVERY non-report sidecar the
  # engines write beside the reports — not just the callgraph/hierarchy pair: candor-scan also writes
  # `report.calibrated.json` + `report.encountered-<crate>.json` ledgers and `--gate-json` verdicts,
  # which previously counted as phantom "engines" and made the dispatcher refuse its own scan output
  # ("multiple engines' reports … disambiguate"). Same discrimination rule as the engines' loaders.
  local f b uniq="" n=0
  for f in "${files[@]}"; do
    [ -e "$f" ] || continue
    case "$f" in
      *.callgraph.json|*.hierarchy.json|*.calibrated.json|*.gate.json|*.encountered-*.json) continue;;
    esac
    b="${f%.json}"
    case "$(basename "$b")" in
      *.*) b="${b##*.}";;
      # a token-less `<name>.json` carries no backend in its NAME (candor-ts's primary shape — but
      # ALSO any engine's `--json > baseline.json` style direct output, which the old JS assumption
      # misrouted; max-review find). Sniff the §2.1 envelope's `candor.toolchain` instead: jdk-* →
      # java, swiftsyntax → swift, node-* → ts; anything else (stable/nightly/unreadable) follows
      # the family rule's open remainder → rust falls out of the sniffer's default below.
      *)   b="$(sniff_backend "$f")";;
    esac
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  done
  # a family prefix may ALSO carry the token-less `<prefix>.json` (the candor-ts shape) — the
  # `<prefix>.*.json` glob can never match it (no inner dot segment), so probe it directly. This runs
  # UNCONDITIONALLY (not only when n==0): a ts report.json beside a tokened engine's reports must
  # trip the multiple-engines ambiguity check, never be silently shadowed (max-review find).
  if [ -n "$famprefix" ] && [ -f "$famprefix.json" ]; then
    b="$(sniff_backend "$famprefix.json")"
    case " $uniq " in *" $b "*) ;; *) uniq="$uniq $b"; n=$((n+1));; esac
  fi
  [ "$n" -ge 1 ] || die "no report at ${loc:-the discovered .candor/} — run \`candor scan\` first, or check the --report locator."
  [ "$n" -eq 1 ] || die "multiple engines' reports at ${loc:-the discovered .candor/} (${uniq# }) — disambiguate with --report <locator>."

  # TS/Java/Swift use FIXED backend tokens; Rust owns the open remainder — `scan` (syntactic backend) plus
  # the nightly-lint crate-types (`lib`, `Executable`, `Rlib`, `Dylib`, `bin`, …). So match the three fixed
  # tokens explicitly and route everything else to candor-query, exactly as the Rust engine's own
  # report-backend detection does (any non-JS/jvm/Swift, non-sidecar report is a Rust report).
  case "${uniq# }" in
    JS)    if have candor-ts-query; then run candor-ts-query "$verb" "$@"
           else run npx -y -p candor-ts candor-ts-query "$verb" "$@"; fi;;
    jvm)   run_java "$verb" "$@";;
    Swift) have candor-swift || die "a Swift report, but candor-swift isn't installed."; run candor-swift "$verb" "$@";;
    *)     local c; c=$(rust_bin candor-query) || die "a Rust report, but candor-query isn't installed — install candor-rust."; run "$c" "$verb" "$@";;
  esac
}

# ---- SCAN: route by the project manifest ---------------------------------------------------------------
route_scan() {
  local a target="."
  for a in "$@"; do case "$a" in -*) ;; *) target="$a"; break;; esac; done
  local dir; if [ -d "$target" ]; then dir="$target"; else dir="$(dirname "$target")"; fi

  # a Java project = any Gradle/Maven manifest, or a loose *.java (checked one at a time — a single
  # `ls a b c` fails whenever ANY pattern is unmatched, which would hide a real match).
  java_manifest() {
    local g
    for g in "$dir/build.gradle" "$dir/build.gradle.kts" "$dir/settings.gradle" "$dir/settings.gradle.kts" "$dir/pom.xml"; do
      [ -f "$g" ] && return 0
    done
    for g in "$dir"/*.java; do [ -e "$g" ] && return 0; done
    return 1
  }
  local langs="" n=0
  add() { case " $langs " in *" $1 "*) ;; *) langs="$langs $1"; n=$((n+1));; esac; }
  [ -f "$dir/Cargo.toml" ] && add rust
  { [ -f "$dir/package.json" ] || [ -f "$dir/tsconfig.json" ]; } && add ts
  java_manifest && add java
  [ -f "$dir/Package.swift" ] && add swift

  [ "$n" -ge 1 ] || die "can't tell what language $dir is (no Cargo.toml / package.json / build.gradle / Package.swift). Run the engine directly: candor-scan | candor-ts | candor-java | candor-swift."
  [ "$n" -eq 1 ] || die "$dir mixes languages (${langs# }) — scan a specific subdirectory, or run the engine directly."

  case "${langs# }" in
    rust)  local c; c=$(rust_bin candor-scan) || die "a Rust project, but candor-scan isn't installed — install candor-rust."; run "$c" "$@";;
    ts)    if have candor-ts; then run candor-ts "$@"
           else run npx -y candor-ts "$@"; fi;;
    java)  run_java "$@";;
    swift) have candor-swift || die "a Swift project, but candor-swift isn't installed."; run candor-swift "$@";;
  esac
}

verb="${1:-}"
case "$QUERY_VERBS" in
  *" $verb "*) route_query "$@"; exit $?;;
esac
case "$verb" in
  ""|-h|--help)
    cat <<'H'
candor — the effect analyzer. One command across every language.

Each invocation routes to the matching engine: a scan by the
project's manifest, a query by the discovered report's backend. Every engine speaks
the same grammar, so verbs and flags pass straight through — and an ambiguous
target is a loud error, never a silent guess.

USAGE
  candor scan <dir>                    analyse a project (engine picked by its manifest)
  candor <action> [args] [options]     query the discovered report (.candor/, walk-up)
  candor doctor                        check every engine is installed and compatible

COMMON ACTIONS
  where <Effect>            the functions that perform an effect
  path <fn> <Effect>        the call path by which a function reaches an effect
  callers <fn>              who calls a function, direct and transitive
  tour [N]                  the N most surprising transitive reaches (default 10)
  blindspots                the Unknown sources worth resolving, ranked by reach
  gains <current> <base>    what a new version newly reaches (the supply-chain diff)
  fix <fn> <Effect>         the boundary hoist that would clear a violation

ALL ACTIONS
  show  where  callers  map  containment  diff  reachable  impact  blindspots
  gains  path  tour  whatif  fix  fix-gate  unverified  rewire  parsepolicy  agents

OPTIONS  (uniform across every engine)
  --report <locator>        use this report instead of discovering .candor/
  --policy <file>           evaluate a policy — exit 1 on a violation
  --json                    machine-readable output

EXAMPLES
  candor scan .
  candor where Db
  candor path OrderService.render Net
  candor gains lib-2.0.jar lib-1.9.jar

ENGINES
  rust    candor-scan / candor-query    cargo install, or candor-rust/install.sh
  jvm     the candor-java jar           ~/.candor/*.jar, or CANDOR_JAVA_JAR
  ts      candor-ts                     runs via npx when not installed
  swift   candor-swift                  build from the candor-swift repo

Docs: candor.poly.io   ·   Verify an install: candor doctor
H
    exit 0;;
  -V|--version) echo "candor dispatcher (umbrella) — routes queries by report backend, scans by manifest"; exit 0;;
  doctor)
    # one-shot install check: each engine's presence + version, and SPEC agreement (the interop
    # contract — matching `spec` matters; build versions may differ per the versioning ladder).
    rc=0; specs=""
    report() { # $1 name, $2 version-line-or-empty, $3 hint
      if [ -n "$2" ]; then
        printf "  %-14s %s\n" "$1" "$2"
        s=$(printf "%s" "$2" | sed -n 's/.*(spec \([0-9.]*\)).*/\1/p'); [ -n "$s" ] && specs="$specs $s"
      else
        printf "  %-14s MISSING — %s\n" "$1" "$3"; rc=1
      fi
    }
    rb="$(rust_bin candor-scan 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust scan" "$v" "cargo install candor-scan (or candor-rust/install.sh)"
    rb="$(rust_bin candor-query 2>/dev/null)" && v=$("$rb" --version 2>/dev/null | head -1) || v=""
    report "rust query" "$v" "cargo install candor-query"
    if have candor-java; then v=$(candor-java --version 2>/dev/null | head -1)
    else jar="${CANDOR_JAVA_JAR:-$(ls "$HOME"/.candor/candor-java*-all.jar 2>/dev/null | head -1)}"
         { [ -n "$jar" ] && [ -f "$jar" ]; } && v=$(java -jar "$jar" --version 2>/dev/null | head -1) || v=""; fi
    report "jvm" "$v" "stash the release jar in ~/.candor/ or set CANDOR_JAVA_JAR"
    if have candor-ts; then v=$(candor-ts --version 2>/dev/null | head -1)
    else v=$(npx -y candor-ts --version 2>/dev/null | head -1); [ -n "$v" ] && v="$v (via npx)"; fi
    report "ts" "$v" "npx -y candor-ts (needs node) or npm i -g candor-ts"
    if have candor-swift; then report "swift" "$(candor-swift --version 2>/dev/null | head -1)" ""
    else printf "  %-14s not installed (optional — build from candor-swift)\n" "swift"; fi
    u=$(printf "%s\n" $specs | sort -u | grep -c .)
    if [ "$u" -gt 1 ]; then
      echo "  ✘ SPEC DRIFT: installed engines declare different spec versions ($(printf "%s" "$specs" | tr ' ' ',' | sed 's/^,//')) — upgrade the stragglers."; rc=1
    elif [ "$u" -eq 1 ]; then
      echo "  ✔ all installed engines agree on spec $(printf "%s\n" $specs | sort -u)"
    fi
    exit $rc;;
  scan) shift; route_scan "$@";;
  *)    route_scan "$@";;
esac
