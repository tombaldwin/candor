#!/usr/bin/env python3
"""candor-sarif — turn a candor policy verdict into SARIF 2.1.0 so architecture-gate violations
surface WHERE code review happens: inline on the PR diff AND in the GitHub Code-scanning / Security tab.

It is a reporter over the STANDARD outputs — the spec-0.8 report envelope + the engine's structured
`gate --json` verdict — so one implementation serves every engine (nothing here is JVM-specific except
the loc→path resolution note below). It does NOT re-run analysis and never changes the pass/fail verdict;
the engine's exit code stays the source of truth. See PR-GATE-DESIGN.md.

Usage:
    candor-sarif <report.json> --gate <gate.json> [--src-root DIR] [--query-cmd "CMD"] [-o out.sarif]

    <report.json>   the spec-0.8 report (carries each function's `loc`)
    --gate FILE     the engine's `gate --json` output: {"violations":[{fn,rule,effects,loc,hash?,...}],"ok":bool}
                    ('-' or omitted → read from stdin). ⟨0.32⟩ a row's OPTIONAL `hash` is the unit
                    identity (SPEC §2.2): with it, two same-named units in different packages get
                    distinct alerts. Without it the tool falls back to `loc`, and discloses the one case
                    it cannot separate — see `unit_key`.
    --src-root DIR  source root the SARIF `uri` is relative to (default "."). candor-java's `loc` is a bare
                    `File.java:line` (the bytecode SourceFile), so the repo path is rebuilt from the fn's
                    package: app.domain.Order.audit + Order.java → <src-root>/app/domain/Order.java. Scan
                    engines whose `loc` is already a path use it as-is.
    --query-cmd CMD optional engine query command (e.g. 'java -jar candor-java-all.jar' — NO scan target:
                    the tool appends `path <report> <fn> <effect> --json`); when set,
                    each violation gets a SARIF codeFlow from `CMD path <fn> <effect>` — the hop chain to
                    the effect source, rendered as a clickable trace in the Security tab.
    -o FILE         write SARIF here (default stdout).

Exit: 0 always (surfacing is advisory; the gate already decided). A malformed input is reported on stderr
and yields an empty-results SARIF rather than a crash — never masks the gate.
"""
import argparse, hashlib, json, re, shlex, subprocess, sys

INFO_URI = "https://candor.poly.io"
SPEC_URI = "https://github.com/tombaldwin/candor/blob/main/README.md"

# AS-EFF rule metadata (the codes candor's policy checker emits). helpUri points at the concept.
RULES = {
    "AS-EFF-001": ("UndeclaredEffect", "A class performs an effect its capabilities don't cover (conformance)."),
    "AS-EFF-002": ("UnusedCapability", "A class injects a capability it never uses (conformance)."),
    "AS-EFF-003": ("UnresolvedCalls", "A class makes calls candor cannot resolve (conformance)."),
    "AS-EFF-004": ("AmbientAuthority", "A function uses ambient authority directly instead of an injected capability."),
    "AS-EFF-005": ("BaselineEffectGained", "A function gained an effect versus the recorded baseline (ratchet)."),
    "AS-EFF-006": ("EffectBoundaryCrossed", "A function performs an effect a policy rule forbids in its layer."),
    "AS-EFF-007": ("InjectionRisk", "An injection-class effect on caller-derived input (heuristic; advisory)."),
    "AS-EFF-008": ("EffectHostNotAllowlisted", "A function reaches a host/effect outside the allowlist."),
    "AS-EFF-009": ("ForbiddenEffectFlow", "A forbidden layer→effect flow is transitively reachable."),
    "AS-EFF-010": ("ContainmentBreached", "An effect escaped the layer it is contained to."),
    # ⟨0.29⟩ its OWN rule id, not 009's. GitHub code scanning dedups, links and DISMISSES by rule id, so
    # sharing `forbid`'s would let one dismissal silently cover both — and they are opposite constructs.
    "AS-EFF-011": ("PermissionScopeExceeded", "A function reaches a scope an `only` permission rule does not list."),
}

# SARIF level per code. AS-EFF-007 is the sole heuristic ADVISORY (candor-spec §6 — it never fails CI, so
# `ok` can stay true with a 007 in `violations`); it must surface as `warning`, not a false `error` alert.
# Every other code is gate-failing → `error`.
def level_of(rule):
    return "warning" if rule == "AS-EFF-007" else "error"


def load_json(path, what):
    """Load a JSON OBJECT. Anything else (unreadable, unparsable, a top-level list/scalar) is disclosed
    on stderr and degrades to {} — the docstring's crash contract: malformed input never tracebacks."""
    try:
        raw = sys.stdin.read() if path in (None, "-") else open(path, encoding="utf-8").read()
        data = json.loads(raw)
    except Exception as e:
        print(f"candor-sarif: could not read {what} ({path}): {e}", file=sys.stderr)
        return {}
    if not isinstance(data, dict):
        print(f"candor-sarif: {what} ({path}) is not a JSON object (got {type(data).__name__}) — ignoring it",
              file=sys.stderr)
        return {}
    return data


def dict_items(container, key, what):
    """`container[key]` as a list of dicts; a non-list value or non-dict item is disclosed and skipped
    (per-item — one malformed entry must not drop the well-formed rest)."""
    items = (container or {}).get(key, [])
    if not isinstance(items, list):
        print(f"candor-sarif: {what}.{key} is not a list — ignoring it", file=sys.stderr)
        return []
    out = []
    for it in items:
        if isinstance(it, dict):
            out.append(it)
        else:
            print(f"candor-sarif: skipping a non-object entry in {what}.{key} ({type(it).__name__})",
                  file=sys.stderr)
    return out


def str_or_none(v):
    """A non-empty string, else None. Used for identity/loc fields, where an int, a null or `""` must
    degrade to "no identity" rather than become one."""
    return v if isinstance(v, str) and v.strip() else None


def unit_index(report):
    """⟨0.32⟩ THE TWO JOINS, AND WHICH ONE IS SOUND.

    SPEC §2.2 requires a consumer to join units by `hash` and NEVER by bare `fn`: names repeat across
    packages, and they are not unique even WITHIN one report (an inherent method and a trait
    implementation of the same name emit two entries sharing `fn`). §2's ⟨0.32⟩ clause names THIS TOOL
    as the consumer that got it wrong.

    …AND `hash` ALONE IS NOT THE IDENTITY EITHER. candor-ts's `hash` is `<package>#<local tail>` and is
    documented NON-UNIQUE by ts itself — 13 collisions in one real project, five `handle` methods all
    keyed `src#handle`. ts's identity is the PAIR, `fn` + `hash`. So the joins are a LADDER, and every
    rung refuses rather than guesses:

    Returns (by_pair, by_hash, by_fn, ambiguous):
      by_pair    (`fn`, `hash`) -> the entry. The identity join proper; the pair separates two units a
                 non-unique `hash` puts in the same bucket.
      by_hash    `hash` -> the entry, for hashes the report holds exactly ONE entry for. Serves a row
                 that spells `fn` differently from the report, and is WITHHELD on a collision.
      by_fn      `fn` -> the entry, for the ONE-ENTRY case only.
      ambiguous  the set of `fn`s the report carries MORE THAN ONE entry for.

    A name in `ambiguous` is deliberately ABSENT from `by_fn`, and a collided hash is likewise absent
    from `by_hash`. The old indexes were last-one-wins, which is worse than useless here: a violation on
    one unit would be decorated with a SIBLING'S `loc`, and a SARIF alert pointing at the wrong file is a
    fabricated location, not a missing one. Withholding the decoration says "cannot attribute"; borrowing
    one says something false."""
    by_pair, by_hash, by_fn, ambiguous = {}, {}, {}, set()
    hash_seen = set()
    for f in dict_items(report, "functions", "report"):
        fn = str_or_none(f.get("fn"))
        if not fn:
            continue
        h = str_or_none(f.get("hash"))
        if h:
            # the same withhold-on-collision rule as `by_fn` below, on both keys
            by_pair[(fn, h)] = None if (fn, h) in by_pair else f
            if h in hash_seen:
                by_hash.pop(h, None)
            else:
                hash_seen.add(h)
                by_hash[h] = f
        if fn in by_fn or fn in ambiguous:
            by_fn.pop(fn, None)
            ambiguous.add(fn)
        else:
            by_fn[fn] = f
    return by_pair, by_hash, by_fn, ambiguous


def unit_key(fn, v_hash, entry, loc, ambiguous, collided):
    """The identity half of a result's fingerprint — what tells two units apart. DEGRADES DELIBERATELY,
    because the field it wants is not yet emitted everywhere.

      1. the verdict row's own `fn` AND `hash` TOGETHER — ⟨0.32⟩'s "a verdict row MUST carry enough
         identity for a consumer to tell two units apart". This is the answer; the rest exist because an
         engine may not carry it. It is the PAIR and not the hash alone because candor-ts's `hash` is
         `<package>#<local tail>`, which ts documents as non-unique (five `handle` methods in one real
         package all key `src#handle`) — so keying on it alone hides one unit behind another exactly as
         keying on the name did. The pair costs the churn of a rename re-opening an alert, which is the
         direction to be wrong in: a churned alert is visible and a hidden one is not.
      2. the report entry's `hash`, paired with the same `fn`, when the row resolved to exactly one
         entry. Same identity, joined one hop later.
      3. `fn@loc`, when the report shows the name is AMBIGUOUS and no hash is reachable. A location is a
         weaker key than an identity — moving the code re-opens the alert — but that is the right way to
         be wrong: a churned alert is visible and a hidden one is not.
      4. bare `fn`, when the name is unambiguous in this report. Not a fallback so much as the correct
         answer for that case: one entry, one unit, nothing to confuse it with.

    A name that is ambiguous AND has no loc to separate the rows is the one case this cannot key, so it
    is DISCLOSED on stderr rather than passed off as a fingerprint — the collision is real and the reader
    is the only one who can act on it."""
    if v_hash:
        return f"hash:{v_hash}|fn:{fn}"
    if entry is not None:
        h = str_or_none(entry.get("hash"))
        if h:
            return f"hash:{h}|fn:{fn}"
    if fn in ambiguous:
        if loc:
            return f"fn:{fn}@{loc}"
        if fn not in collided:
            collided.add(fn)
            print(f"candor-sarif: `{fn}` names more than one unit in the report and the verdict row "
                  f"carries neither `hash` nor `loc` — its alerts cannot be told apart and GitHub will "
                  f"dedup them into one. Re-run the gate with an engine that emits unit identity.",
                  file=sys.stderr)
    return "fn:" + fn


def entry_effects(entry):
    """An entry's `direct` effect names (the effects it performs itself — what a codeFlow to the source
    should trace), falling back to `inferred`. `None` entry -> []."""
    if not isinstance(entry, dict):
        return []
    return entry.get("direct") or entry.get("inferred") or []


def parse_loc(loc):
    """`File.java:6` or `path/f.rs:10:1: 10:9` -> (file, startLine, startCol, endLine, endCol)."""
    if not loc or not isinstance(loc, str):
        return None            # a malformed (non-string) loc is dropped, never a crash
    m = re.match(r"^(.*?):(\d+)(?::(\d+))?(?::\s*(\d+):(\d+))?$", loc.strip())
    if not m:
        # a bare filename with no line — locate the file, no region
        return (loc.strip(), None, None, None, None)
    f, l1, c1, l2, c2 = m.group(1), m.group(2), m.group(3), m.group(4), m.group(5)
    return (f, int(l1), int(c1) if c1 else None, int(l2) if l2 else None, int(c2) if c2 else None)


def repo_uri(fn, locfile, src_root):
    """Repo-relative path for the SARIF `uri`. If `locfile` already looks like a path (has a separator) it is
    a scan engine's already-repo-relative loc — trust it as-is. Else it is a bytecode bare filename
    (candor-java's SourceFile) — rebuild it from the fn's package under --src-root: a.b.C.m + C.java (root
    `src`) -> src/a/b/C.java. --src-root ONLY affects this rebuild; a path-style loc is never re-rooted."""
    if "/" in locfile:
        return locfile
    root = src_root.rstrip("/")
    pkg = ""
    # the package is the fn minus the last two dotted segments (Class.method); best-effort.
    parts = fn.split(".")
    if len(parts) >= 3:
        pkg = "/".join(parts[:-2])
    uri = f"{pkg}/{locfile}" if pkg else locfile
    return f"{root}/{uri}" if root and root != "." else uri


def physical_location(fn, loc, src_root):
    p = parse_loc(loc)
    if not p:
        return None
    locfile, l1, c1, l2, c2 = p
    region = {}
    if l1:
        region["startLine"] = l1
        if c1:
            region["startColumn"] = c1
        if l2:
            region["endLine"] = l2
        if c2:
            region["endColumn"] = c2
    ph = {"artifactLocation": {"uri": repo_uri(fn, locfile, src_root)}}
    if region:
        ph["region"] = region
    return {"physicalLocation": ph}


def code_flow(query_cmd, report_path, fn, effect, src_root, loc_idx):
    """Run `CMD path <report> <fn> <effect> --json` -> a SARIF codeFlow (the hop chain to the source)."""
    if not query_cmd or not effect:
        return None
    try:
        out = subprocess.run(shlex.split(query_cmd) + ["path", report_path, fn, effect, "--json"],
                             capture_output=True, text=True, timeout=120)
        data = json.loads(out.stdout)
    except Exception as e:
        print(f"candor-sarif: path query failed for {fn}/{effect}: {e}", file=sys.stderr)
        return None
    hops = data.get("path") or []
    if not hops:
        return None
    tf = []
    for h in hops:
        hfn = h.get("fn", "?")
        hloc = h.get("loc") or loc_idx.get(hfn)
        ph = physical_location(hfn, hloc, src_root) if hloc else None
        step = {"location": {"message": {"text": f"{hfn}{' — source' if h.get('source') else ''}"}}}
        if ph:
            step["location"].update(ph)
        tf.append(step)
    return [{"threadFlows": [{"locations": tf}]}]


def build_sarif(report, report_path, gate, src_root, query_cmd):
    by_pair, by_hash, by_fn, ambiguous = unit_index(report)
    # codeFlow hops name a callee by BARE `fn` (SPEC §4), so an ambiguous name has no location this tool
    # can attribute. `by_fn` already excludes those, which turns a wrong hop location into an absent one.
    loc_idx = {k: e["loc"] for k, e in by_fn.items() if str_or_none(e.get("loc"))}
    violations = dict_items(gate, "violations", "gate")
    seen_rules, results, collided, fp_src = {}, [], set(), []
    for v in violations:
        fn, rule = v.get("fn"), v.get("rule", "AS-EFF-006")
        if not fn or not isinstance(fn, str):
            continue
        if not isinstance(rule, str):
            rule = "AS-EFF-006"    # a malformed rule id degrades to the generic policy code, never crashes
        # ⟨0.32⟩ RESOLVE THE UNIT BEFORE DECORATING IT, DOWN A LADDER WHOSE EVERY RUNG REFUSES RATHER
        # THAN GUESSES. The (`fn`, `hash`) PAIR is the identity join (§2.2) — not `hash` alone, which
        # candor-ts documents as non-unique. Failing that, a `hash` the report holds exactly ONE entry
        # for, which serves a row spelling `fn` differently; a COLLIDED hash is withheld, so a row whose
        # pair matched nothing gets no decoration instead of the last-indexed sibling's. Only a row with
        # NO hash at all reaches the name join, and only when the name is unambiguous — so `loc` and the
        # effects fallback come back empty rather than borrowed from a same-named sibling.
        v_hash = str_or_none(v.get("hash"))
        if v_hash:
            entry = by_pair.get((fn, v_hash))
            if entry is None:
                entry = by_hash.get(v_hash)
        else:
            entry = by_fn.get(fn)
        # effects: trust the verdict's denied set when the KEY is present — an explicit [] means "no single
        # effect" (a 009 layer-flow / 003 unresolved) and MUST be respected, not overwritten by the report's
        # (superset) direct set. Only fall back to the report when a verdict omits the key entirely (a pre-0.8
        # / non-emitting engine). loc always joins from the report.
        effects = v["effects"] if "effects" in v else entry_effects(entry)
        if not isinstance(effects, list):
            effects = []       # a malformed verdict (effects: null / non-list) degrades, never crashes
        effects = [e for e in effects if isinstance(e, str)]
        loc = str_or_none(v.get("loc")) or (str_or_none(entry.get("loc")) if entry else None)
        scope = v.get("scope")
        # `detail` (from the engine's own diagnostic) is authoritative and already names fn/effect/rule;
        # only compose a message when the verdict didn't carry one.
        detail = v.get("detail")
        if not isinstance(detail, str):
            detail = None          # a non-string detail degrades to the composed message, never crashes
        if detail:
            text = detail
        else:
            eff_txt = "{" + ", ".join(effects) + "}" if effects else "a forbidden effect"
            text = f"{fn} performs {eff_txt}"
            if scope:
                text += f" — crossing the `{scope}` boundary"
        seen_rules.setdefault(rule, RULES.get(rule, (rule, "A candor architecture-policy violation.")))
        res = {
            "ruleId": rule,
            "level": level_of(rule),
            "message": {"text": text},
            # Content-based fingerprint (GitHub tracks/dedups alerts by it): include the effect(s), else a
            # fn that violates two rules for DIFFERENT effects (e.g. `deny Fs` + `deny Env` both hitting one
            # method) collides into a single alert, hiding a real violation. Content-based (not positional) so
            # it stays stable as results reorder between runs.
            #
            # ⟨0.32⟩ …AND THE NAME IS NOT THE UNIT. This read `fn|rule|effects`, and SPEC §2 names it: "a
            # consumer that fingerprints on name alone silently hides one finding behind another". Two
            # units that differ only by package — or an inherent method and a trait implementation of the
            # same name in ONE report — produce identical fingerprints, so GitHub dedups them into a
            # single alert and one real violation disappears DOWNSTREAM of a red gate. The gate is still
            # red; the reviewer is shown one finding and fixes it, and the second is never surfaced.
            "partialFingerprints": {"candorViolation": ""},   # filled below, after the collision sweep
        }
        fp_src.append((f"{unit_key(fn, v_hash, entry, loc, ambiguous, collided)}"
                       f"|{rule}|{','.join(effects)}", loc, text))
        if effects:
            res["properties"] = {"effects": effects}   # the denied set, structured (not just in the message prose)
        ph = physical_location(fn, loc, src_root) if loc else None
        res["locations"] = [ph] if ph else []
        cf = code_flow(query_cmd, report_path, fn, effects[0] if effects else None, src_root, loc_idx)
        if cf:
            res["codeFlows"] = cf
        results.append(res)

    # ⟨0.32⟩ THE INVARIANT IS CHECKED, NOT ASSUMED: two results that are DIFFERENT findings must not
    # share a fingerprint. `unit_key` above picks the best identity each row offers, but the identity can
    # still be UNAVAILABLE — a multi-report gate whose rows carry no `hash`, handed the report for one
    # member, resolves two rows to the one entry it can see and keys them identically. That is the same
    # silent hide by another route, so the sweep is over the OUTPUT rather than over any one input.
    #
    # A tie is only re-keyed when the two rows sit at DIFFERENT locations. A tie at the SAME location is
    # one finding listed twice, and collapsing it is correct — inventing an ordinal there would split one
    # alert into two that flip places between runs, which is the churn this whole design avoids.
    #
    # …AND "SAME LOCATION" WAS THE HOLE. That test is only sound when the locations are the rows' OWN. A
    # last-one-wins index handed two rows the SAME borrowed loc, so the sweep read two distinct findings
    # as one listed twice and passed in silence — the very hide it exists to catch, arriving through the
    # instrument. Rows that SAY DIFFERENT THINGS are not one finding, whatever their locations agree on.
    # There is nothing left to re-key them by at that point (a location that cannot separate them is the
    # only key on offer), so the obligation is the disclosure: the reader is the one who can act on it.
    tied = {}
    for i, e in enumerate(fp_src):
        tied.setdefault(e[0], []).append(i)
    for k, idxs in tied.items():
        if len(idxs) < 2:
            continue
        distinct_locs = {fp_src[i][1] for i in idxs}
        if len(distinct_locs) > 1:
            print(f"candor-sarif: {len(idxs)} verdict rows share the identity `{k.split('|')[0]}` and no "
                  f"`hash` distinguishes them; falling back to their locations so GitHub does not dedup "
                  f"distinct findings into one alert.", file=sys.stderr)
            for i in idxs:
                fp_src[i] = (f"{k}@{fp_src[i][1] or ''}", fp_src[i][1], fp_src[i][2])
        elif len({fp_src[i][2] for i in idxs}) > 1:
            print(f"candor-sarif: {len(idxs)} verdict rows share the identity `{k.split('|')[0]}` at one "
                  f"location but say different things, so nothing here can tell them apart and GitHub "
                  f"will dedup them into a single alert. Re-run the gate with an engine that emits unit "
                  f"identity, or with a `loc` on each row.", file=sys.stderr)
    for res, (k, _, _) in zip(results, fp_src):
        res["partialFingerprints"]["candorViolation"] = hashlib.sha256(k.encode()).hexdigest()[:16]

    rules = [{
        "id": rid,
        "name": name,
        "shortDescription": {"text": desc},
        "helpUri": SPEC_URI,
        "defaultConfiguration": {"level": level_of(rid)},
    } for rid, (name, desc) in sorted(seen_rules.items())]
    return {
        "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
        "version": "2.1.0",
        "runs": [{
            "tool": {"driver": {"name": "candor", "informationUri": INFO_URI, "rules": rules}},
            "results": results,
        }],
    }


def main(argv=None):
    ap = argparse.ArgumentParser(prog="candor-sarif", add_help=True)
    ap.add_argument("report")
    ap.add_argument("--gate", default="-")
    ap.add_argument("--src-root", default=".")
    ap.add_argument("--query-cmd", default=None)
    ap.add_argument("-o", "--out", default=None)
    args = ap.parse_args(argv)

    report = load_json(args.report, "report") or {"functions": []}
    gate = load_json(args.gate, "gate") or {"violations": []}
    sarif = build_sarif(report, args.report, gate, args.src_root, args.query_cmd)
    text = json.dumps(sarif, indent=2)
    if args.out:
        try:
            open(args.out, "w", encoding="utf-8").write(text + "\n")
        except OSError as e:
            # surfacing is advisory (the gate already decided): disclose and keep the exit-0 contract
            print(f"candor-sarif: could not write {args.out}: {e}", file=sys.stderr)
    else:
        print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
